  67          
  68          /* SPI timeout flag. Set by SPI_Transfer / SPI_Receive when their wait
  69           * loops time out so callers can distinguish a real 0xFF data byte from
  70           * an error. volatile because it may be set inside TIMER1_Int audio ISR
  71           * (via Read_c) and consumed by main-thread code. */
  72          volatile uint8_t SPI_Timeout = 0;
  73          
  74          
  75          
  76          /**********************************************************************
  77           * @brief   SPI_Receive - clock out a 0xFF dummy and return the byte the
  78           *          slave shifted back on MISO. Bounded wait loops with timeout
  79           *          guards; sets SPI_Timeout on failure.
  80           *          Used from TIMER1_Int audio streaming ISR - must not hang.
  81           * @return  received byte, or 0xFF if timeout (check SPI_Timeout flag).
  82           **********************************************************************/
  83          uint8_t SPI_Receive(void)
  84          {
  85   1        uint16_t wait;
  86   1      
  87   1        USTCR2 |= (DRIE);
  88   1      
  89   1        wait = 0x1000;
  90   1        while((!(USTST & (DRE))) && (--wait));
  91   1        if ((USTST & DRE) == 0) {
  92   2          SPI_Timeout = 1;
  93   2          return 0xFF;
  94   2        }
  95   1      
  96   1        USTDR = 0xFF;                            /* dummy byte to clock in MISO */
  97   1      
  98   1        wait = 0x1000;
  99   1        while(((USTST & RXC) != RXC) && (--wait));
 100   1        if ((USTST & RXC) != RXC) {
 101   2          SPI_Timeout = 1;
 102   2          return 0xFF;
 103   2        }
 104   1      
 105   1        SPI_Timeout = 0;
 106   1        return USTDR;
 107   1      }
 108          
 109          
 110          
 111          /**********************************************************************
 112           * @brief   SPI_Transfer - clock out `value` on MOSI and return the byte
 113           *          shifted in on MISO. Sets SPI_Timeout on wait-loop timeout.
 114           * @param   value - byte to send
 115           * @return  received byte, or 0xFF if timeout (check SPI_Timeout flag).
 116           **********************************************************************/
C51 COMPILER V9.54   FLASH                                                                 06/05/2026 08:42:20 PAGE 3   

 117          uint8_t SPI_Transfer(uint8_t value)
 118          {
 119   1        uint16_t wait;
 120   1      
 121   1        wait= 0x1000;
 122   1        while((!(USTST & (DRE)))&&(wait--));
 123   1      
 124   1        if ((USTST & DRE) == 0) {
 125   2          SPI_Timeout = 1;
 126   2          return 0xFF;
 127   2        }
 128   1      
 129   1        wait= 0x1000;
 130   1        USTDR = value;
 131   1        while((( USTST & RXC)!= RXC)&&(wait--));
 132   1      
 133   1        if((USTST & RXC) != RXC) {
 134   2          SPI_Timeout = 1;
 135   2          return 0xFF;
 136   2        }
 137   1      
 138   1        SPI_Timeout = 0;
 139   1        return USTDR;
 140   1      }
 141          
 142          
 143          
 144          /**********************************************************************
 145           * @brief   Get_Identification - read JEDEC ID (3 bytes)
 146           **********************************************************************/
 147          void Get_Identification(uint8_t * id)
 148          {
 149   1        SLAVESELECT;
 150   1        NOP_4us_Delay();                           /* ~4 us CS-setup delay */
 151   1        SPI_Transfer(COMMAND_RDID);
 152   1        id[0] = SPI_Transfer(DUMMY);
 153   1        id[1] = SPI_Transfer(DUMMY);
 154   1        id[2] = SPI_Transfer(DUMMY);
 155   1        SLAVEDESELECT;
 156   1      }
 157          
 158          
 159          void SetAddress(unsigned long address)
 160          {
 161   1        SPI_Transfer( (uint8_t) (address >> 16) );
 162   1        SPI_Transfer( (uint8_t) (address >> 8) );
 163   1        SPI_Transfer( (uint8_t) address );
 164   1      }
 165          
 166          
 167          void Read(unsigned long  address)
 168          {
 169   1        SLAVESELECT;
 170   1      
 171   1        SPI_Transfer(COMMAND_READ);                /* command_read */
 172   1        SetAddress(address);
 173   1        /* CS stays low - subsequent Read_c() calls clock out streaming bytes */
 174   1      }
 175          
 176          
 177          void Read_c( char * value)
 178          {
C51 COMPILER V9.54   FLASH                                                                 06/05/2026 08:42:20 PAGE 4   

 179   1        *(value) = SPI_Receive();
 180   1      }
