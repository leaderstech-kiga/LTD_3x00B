 247          /*----------------------------------------------------------------------------*
 248           * calib_erase_with_animation - STEP 2-1 (SW2 held at power-up).              *
 249           *                                                                            *
 250           *   While SW2 stays held: alternate LED_G / LED_R every CALIB_ANIM_MS.       *
 251           *   When SW2 is released:                                                    *
 252           *     - erase the DataFlash calibration page                                *
 253           *     - reset the RAM globals to defaults (baseline=0, gain=256, valid=0)    *
 254           *     - take ONE Dust_ADC_2AMP() reading as the clean-air baseline           *
 255           *       (the unit must be in clean air at the moment of release)             *
 256           *     - save {baseline, gain=256}, set g_calib_needs_smoke = 1               *
 257           *         success -> LED_G blink 5x at 0.2 s                                 *
 258           *         failure -> LED_R blink 5x at 0.2 s                                 *
 259           *----------------------------------------------------------------------------*/
 260          void calib_erase_with_animation(void)
 261          {
 262   1        uint16_t baseline;
 263   1      
 264   1        /* Alternate G/R while the operator keeps SW2 held. */
 265   1        while (sw2_is_pressed()) {
 266   2          LED_G_ON;
 267   2          LED_R_OFF;
 268   2          wait_ms_kicked(CALIB_ANIM_MS);
 269   2          if (!sw2_is_pressed()) {
 270   3            break;
 271   3          }
 272   2          LED_G_OFF;
 273   2          LED_R_ON;
 274   2          wait_ms_kicked(CALIB_ANIM_MS);
 275   2        }
 276   1        LED_G_OFF;
 277   1        LED_R_OFF;
 278   1      
 279   1        /* SW2 released -> erase the calibration page. */
 280   1        DATAFLASH_PageEr(DF_USER_ID_ERASE, CALIB_ADDR);
 281   1        calib_wait_df_ready();
 282   1        Delay_ms(1);
 283   1      
 284   1        /* Reset RAM globals to the uncalibrated defaults. */
 285   1        g_calib_baseline = CALIB_DEFAULT_BASELINE;   /* 0   */
 286   1        g_calib_gain_Q8  = CALIB_DEFAULT_GAIN_Q8;    /* 256 */
 287   1        g_calib_valid    = 0;
 288   1      
 289   1        /* Capture the clean-air baseline (Dust_ADC_2AMP averages 8 internally). */
 290   1        baseline = Dust_ADC_2AMP();
 291   1      
 292   1        /* Persist baseline with unity gain; smoke gain still to be performed. */
 293   1        g_calib_needs_smoke = 1;
 294   1        if (calib_save(baseline, CALIB_DEFAULT_GAIN_Q8)) {
 295   2          blink_g(CALIB_RESULT_BLINKS, CALIB_BLINK_FAST_MS);   /* save OK   */
 296   2        } else {
 297   2          blink_r(CALIB_RESULT_BLINKS, CALIB_BLINK_FAST_MS);   /* save fail */
 298   2        }
 299   1      }
