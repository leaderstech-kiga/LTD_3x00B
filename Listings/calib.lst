 328          /*----------------------------------------------------------------------------*
 329           * calib_run_smoke - STEP 3 (smoke gain calibration).                         *
 330           *                                                                            *
 331           *   Entered from the main loop when SW2 is held while g_calib_needs_smoke    *
 332           *   is set. Sequence:                                                        *
 333           *      a. LED_R solid, wait for SW2 release.                                 *
 334           *      b. "Place sample" phase: LED_R blinks at 0.2 s for                    *
 335           *         CALIB_SMOKE_PLACE_MS (5 s) - time for the operator to put the      *
 336           *         sensor into the smoke generator.                                   *
 337           *      c. Sampling: LED_R blinks at 0.5 s, take CALIB_SMOKE_SAMPLES          *
 338           *         Dust_ADC_2AMP() readings (~5 s total); smoke_avg = mean.           *
 339           *      d. delta = smoke_avg - baseline.                                      *
 340           *           delta <  CALIB_MIN_DELTA -> reject: LED_R fast blink 5 s,        *
 341           *                                       g_calib_needs_smoke kept = 1 (retry).*
 342           *           delta >= CALIB_MIN_DELTA -> gain_Q8 = (CALIB_REF_DELTA<<8)/delta,*
 343           *                                       calib_save(baseline, gain_Q8):       *
 344           *                                         success -> LED_G fast blink 1 s,   *
 345           *                                                    g_calib_needs_smoke = 0 *
 346           *                                         failure -> LED_G fast blink 1 s,   *
 347           *                                                    g_calib_needs_smoke = 1 *
 348           *                                                                            *
 349           *   Returns to main() in either case (does NOT halt the loop). On success    *
 350           *   the main loop (STEP5) runs fire_monitor_step() immediately so the same   *
 351           *   12% smoke injection also validates the alarm on the production line.     *
 352           *----------------------------------------------------------------------------*/
 353          void calib_run_smoke(void)
 354          {
 355   1        uint32_t sum;
 356   1        uint16_t smoke_avg;
 357   1        uint16_t delta;
 358   1        uint32_t gain32;
 359   1        uint16_t gain_Q8;
 360   1        uint16_t elapsed;
 361   1        uint8_t  i;
 362   1      
 363   1        /* Step a: LED_R on, wait for SW2 release. */
 364   1        LED_R_ON;
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 7   

 365   1        while (sw2_is_pressed()) {
 366   2          WD_Reset();
 367   2          Delay_ms(20);
 368   2        }
 369   1      
 370   1        /* Step b: "place the sample" - LED_R blinks at 0.2 s for 5 s. */
 371   1        elapsed = 0;
 372   1        while (elapsed < CALIB_SMOKE_PLACE_MS) {
 373   2          LED_R_ON;
 374   2          wait_ms_kicked(CALIB_SMOKE_PLACE_BLINK_MS);
 375   2          LED_R_OFF;
 376   2          wait_ms_kicked(CALIB_SMOKE_PLACE_BLINK_MS);
 377   2          elapsed += (uint16_t)(2u * CALIB_SMOKE_PLACE_BLINK_MS);
 378   2        }
 379   1      
 380   1        /* Step c: CALIB_SMOKE_SAMPLES readings, LED_R toggling at 0.5 s. */
 381   1        sum = 0;
 382   1        for (i = 0; i < CALIB_SMOKE_SAMPLES; i++) {
 383   2          LED_R_ON;
 384   2          sum += Dust_ADC_2AMP();
 385   2          wait_ms_kicked(CALIB_SMOKE_BLINK_MS);
 386   2          LED_R_OFF;
 387   2          wait_ms_kicked(CALIB_SMOKE_BLINK_MS);
 388   2        }
 389   1        LED_R_OFF;
 390   1        smoke_avg = (uint16_t)(sum / CALIB_SMOKE_SAMPLES);
 391   1      
 392   1        /* Step d: validate delta against the baseline captured in step 2-1. */
 393   1        if (smoke_avg <= g_calib_baseline) {
 394   2          delta = 0;
 395   2        } else {
 396   2          delta = smoke_avg - g_calib_baseline;
 397   2        }
 398   1      
 399   1        if (delta < CALIB_MIN_DELTA) {
 400   2          /* Not enough smoke - reject. Keep the flag so the operator can
 401   2           * retry by holding SW2 again. */
 402   2          blink_r((uint8_t)(CALIB_FAIL_BLINK_MS / (2u * CALIB_BLINK_FAST_MS)),
 403   2                  CALIB_BLINK_FAST_MS);
 404   2          g_calib_needs_smoke = 1;
 405   2          return;
 406   2        }
 407   1      
 408   1        /* gain_Q8 = (REF << 8) / delta. */
 409   1        gain32  = ((uint32_t)CALIB_REF_DELTA) << 8;
 410   1        gain32 /= delta;
 411   1        if (gain32 > 0xFFFFu) {
 412   2          gain32 = 0xFFFFu;
 413   2        }
 414   1        gain_Q8 = (uint16_t)gain32;
 415   1      
 416   1        if (calib_save(g_calib_baseline, gain_Q8)) {
 417   2          blink_g((uint8_t)(CALIB_OK_BLINK_MS / (2u * CALIB_BLINK_FAST_MS)),
 418   2                  CALIB_BLINK_FAST_MS);
 419   2          g_calib_needs_smoke = 0;
 420   2        } else {
 421   2          /* Save / verify failed - keep the flag so the operator can retry. */
 422   2          blink_g((uint8_t)(CALIB_OK_BLINK_MS / (2u * CALIB_BLINK_FAST_MS)),
 423   2                  CALIB_BLINK_FAST_MS);
 424   2          g_calib_needs_smoke = 1;
 425   2        }
 426   1      
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 8   

 427   1        /* Fire monitoring after a successful calibration is done by the main
 428   1         * loop (STEP5 calls fire_monitor_step() right after this returns). */
 429   1      }
