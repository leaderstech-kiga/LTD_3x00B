 183          /*----------------------------------------------------------------------------*
 184           * SW2 polling helper                                                         *
 185           *   sw2_is_pressed : 1 when the button is held down (P12 reads 0 with the    *
 186           *                   internal pull-up enabled).                               *
 187           *----------------------------------------------------------------------------*/
 188          static uint8_t sw2_is_pressed(void)
 189          {
 190   1        return (Port_GetInputpinValue(PORT1, PIN2) == 0);
 191   1      }
 192          
 193          /* Long delay broken into 100 ms chunks so WDT (RESET mode, ~2 s timeout)
 194           * stays happy. */
 195          static void wait_ms_kicked(uint16_t total_ms)
 196          {
 197   1        uint16_t left = total_ms;
 198   1        while (left >= 100) {
 199   2          Delay_ms(100);
 200   2          WD_Reset();
 201   2          left -= 100;
 202   2        }
 203   1        if (left) {
 204   2          Delay_ms(left);
 205   2          WD_Reset();
 206   2        }
 207   1      }
 208          
 209          /* Generic blink helpers: half_ms on, half_ms off, repeated `cycles` times.
 210           * WDT-safe via wait_ms_kicked. */
 211          static void blink_g(uint8_t cycles, uint16_t half_ms)
 212          {
 213   1        uint8_t i;
 214   1        for (i = 0; i < cycles; i++) {
 215   2          LED_G_ON;
 216   2          wait_ms_kicked(half_ms);
 217   2          LED_G_OFF;
 218   2          wait_ms_kicked(half_ms);
 219   2        }
 220   1      }
 221          
 222          static void blink_r(uint8_t cycles, uint16_t half_ms)
 223          {
 224   1        uint8_t i;
 225   1        for (i = 0; i < cycles; i++) {
 226   2          LED_R_ON;
 227   2          wait_ms_kicked(half_ms);
 228   2          LED_R_OFF;
 229   2          wait_ms_kicked(half_ms);
 230   2        }
 231   1      }
