 301          /*----------------------------------------------------------------------------*
 302           * calib_boot_init - STEP 2-2 (SW2 NOT held at power-up).                     *
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 6   

 303           *                                                                            *
 304           *   Load the saved record from DataFlash and update the RAM globals          *
 305           *   (baseline, gain_Q8). If no valid record exists the defaults stay in      *
 306           *   place (baseline=0, gain=256), which leaves readings uncompensated -      *
 307           *   the safest fallback. g_calib_needs_smoke is set when the gain is still   *
 308           *   the default, i.e. smoke calibration has not been performed yet.          *
 309           *----------------------------------------------------------------------------*/
 310          void calib_boot_init(void)
 311          {
 312   1        if (calib_load()) {
 313   2          if(uart_debug_mode == uart_debug_On){
 314   3            Uart_Out_Text(Flash_Read_OK, 17);
 315   3            Uart_Out();
 316   3          }
 317   2        } else {
 318   2          if(uart_debug_mode == uart_debug_On){
 319   3            Uart_Out_Text(Flash_Read_Fail, 19);
 320   3            Uart_Out();
 321   3          }
 322   2        }
 323   1      
 324   1        /* g_calib_gain_Q8 == default means no smoke cal has been done. */
 325   1        g_calib_needs_smoke = (g_calib_gain_Q8 == CALIB_DEFAULT_GAIN_Q8) ? 1 : 0;
 326   1      }
