 233          /*----------------------------------------------------------------------------*
 234           * calib_step1_boot_led - STEP 1.                                             *
 235           *   Power-on indication: LED_G and LED_R on together for 0.2 s, then off.    *
 236           *----------------------------------------------------------------------------*/
 237          void calib_step1_boot_led(void)
 238          {
 239   1        LED_G_ON;
 240   1        LED_R_ON;
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 5   

 241   1        Delay_ms(CALIB_BOOT_LED_MS);
 242   1        LED_G_OFF;
 243   1        LED_R_OFF;
 244   1        WD_Reset();
 245   1      }
