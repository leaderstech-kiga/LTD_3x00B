 101          /*----------------------------------------------------------------------------*
 102           * calib_wait_df_ready - poll the DataFlash busy bit until the self-timed     *
 103           * erase/write operation completes. UM 20: do not start a new DataFlash op    *
 104           * (or read back) while DFMBUSY (DFMCR.7) is still 1. A guard count keeps the *
 105           * loop bounded so a stuck controller cannot hang the firmware.               *
 106           *----------------------------------------------------------------------------*/
 107          static void calib_wait_df_ready(void)
 108          {
 109   1        uint16_t guard = 0;
 110   1        while ((DFMCR & (1 << DFMBUSY)) != 0) {
 111   2          if (++guard >= 50000) {
 112   3            break;                 /* safety timeout */
 113   3          }
 114   2        }
 115   1      }
 116          
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 3   

 117          /*----------------------------------------------------------------------------*
 118           * calib_save - erase + page-write the 32-byte calibration page, then verify *
 119           * with a fresh read-back. Each DataFlash op is self-timed, so we wait on     *
 120           * DFMBUSY before issuing the next op or reading the result back.             *
 121           *----------------------------------------------------------------------------*/
 122          uint8_t calib_save(uint16_t baseline, uint16_t gain_Q8)
 123          {
 124   1        uint8_t buf[SECTOR_SIZE_BYTE];
 125   1        uint16_t magic = CALIB_MAGIC;
 126   1        uint16_t checksum;
 127   1        uint8_t i;
 128   1      
 129   1        checksum = magic ^ baseline ^ gain_Q8;
 130   1      
 131   1        for (i = 0; i < SECTOR_SIZE_BYTE; i++) {
 132   2          buf[i] = 0xFF;             /* erased flash convention */
 133   2        }
 134   1        buf[0] = (uint8_t)(magic       & 0xFF);
 135   1        buf[1] = (uint8_t)(magic       >> 8);
 136   1        buf[2] = (uint8_t)(baseline    & 0xFF);
 137   1        buf[3] = (uint8_t)(baseline    >> 8);
 138   1        buf[4] = (uint8_t)(gain_Q8     & 0xFF);
 139   1        buf[5] = (uint8_t)(gain_Q8     >> 8);
 140   1        buf[6] = (uint8_t)(checksum    & 0xFF);
 141   1        buf[7] = (uint8_t)(checksum    >> 8);
 142   1      
 143   1        DATAFLASH_PageEr(DF_USER_ID_ERASE, CALIB_ADDR);
 144   1        calib_wait_df_ready();
 145   1        Delay_ms(1);
 146   1        DATAFLASH_PageWt(DF_USER_ID_PAGEWR, CALIB_ADDR, buf);
 147   1        calib_wait_df_ready();
 148   1        Delay_ms(1);
 149   1      
 150   1        /* Verify by re-reading the four words. */
 151   1        if (calib_read_word(0) != magic)    return 0;
 152   1        if (calib_read_word(2) != baseline) return 0;
 153   1        if (calib_read_word(4) != gain_Q8)  return 0;
 154   1        if (calib_read_word(6) != checksum) return 0;
 155   1      
 156   1        /* Update RAM copy so the caller does not need a reset to use the new
 157   1         * values for any subsequent calls. */
 158   1        g_calib_baseline = baseline;
 159   1        g_calib_gain_Q8  = gain_Q8;
 160   1        g_calib_valid    = 1;
 161   1        return 1;
 162   1      }
 163          
 164          /*----------------------------------------------------------------------------*
 165           * calib_apply                                                                *
 166           *----------------------------------------------------------------------------*/
 167          uint16_t calib_apply(uint16_t si_da_raw)
 168          {
 169   1        uint32_t scaled;
 170   1      
 171   1        if (si_da_raw <= g_calib_baseline) {
 172   2          return 0;                  /* below baseline: clean-air noise */
 173   2        }
 174   1        scaled  = (uint32_t)(si_da_raw - g_calib_baseline);
 175   1        scaled *= g_calib_gain_Q8;
 176   1        scaled >>= 8;
 177   1        if (scaled > 0xFFFFu) {
 178   2          return 0xFFFFu;
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 4   

 179   2        }
 180   1        return (uint16_t)scaled;
 181   1      }
