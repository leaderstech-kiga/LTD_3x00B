  39          /*----------------------------------------------------------------------------*
  40           * Working copy of calibration. See calib.h for the public extern decl.       *
  41           *----------------------------------------------------------------------------*/
  42          uint16_t g_calib_baseline    = CALIB_DEFAULT_BASELINE;
  43          uint16_t g_calib_gain_Q8     = CALIB_DEFAULT_GAIN_Q8;
  44          uint8_t  g_calib_valid       = 0;
  45          uint8_t  g_calib_needs_smoke = 0;
  46          
  47          /* DataFlash user IDs - see vendor a96l41x_dataflash.c. */
  48          #define DF_USER_ID_ERASE     0xA901358F
  49          #define DF_USER_ID_PAGEWR    0x4F17DC86
  50          
  51          /* DataFlash region 0x3000..0x30FF is a separate area (UM 4.4): it has no
  52           * relation with RAM nor program FLASH and "can be read by using DPTR",
  53           * i.e. with an XDATA (MOVX @DPTR) access - NOT MOVC. Reading it with a
  54           * 'code' pointer returns program-code space at 0x3000 (empty -> 0x00),
C51 COMPILER V9.54   CALIB                                                                 06/05/2026 08:42:21 PAGE 2   

  55           * which is why earlier read-backs always came back 0. Use an 'xdata'
  56           * pointer so the DataFlash array is addressed correctly. */
  57          static uint16_t calib_read_word(uint16_t offset)
  58          {
  59   1        unsigned char xdata *p = (unsigned char xdata *)CALIB_ADDR;
  60   1        uint16_t lo = p[offset];
  61   1        uint16_t hi = p[offset + 1];
  62   1        return (uint16_t)((hi << 8) | lo);
  63   1      }
  64          
  65          /*----------------------------------------------------------------------------*
  66           * calib_load                                                                 *
  67           *----------------------------------------------------------------------------*/
  68          uint8_t calib_load(void)
  69          {
  70   1        uint16_t magic, baseline, gain, checksum, expected;
  71   1      
  72   1        magic    = calib_read_word(0);
  73   1        baseline = calib_read_word(2);
  74   1        gain     = calib_read_word(4);
  75   1        checksum = calib_read_word(6);
  76   1      
  77   1        expected = magic ^ baseline ^ gain;
  78   1      
  79   1        if (magic != CALIB_MAGIC) {
  80   2          goto bad;
  81   2        }
  82   1        if (checksum != expected) {
  83   2          goto bad;
  84   2        }
  85   1        if (gain == 0) {
  86   2          goto bad;                  /* zero gain would zero every reading */
  87   2        }
  88   1      
  89   1        g_calib_baseline = baseline;
  90   1        g_calib_gain_Q8  = gain;
  91   1        g_calib_valid    = 1;
  92   1        return 1;
  93   1      
  94   1      bad:
  95   1        g_calib_baseline = CALIB_DEFAULT_BASELINE;
  96   1        g_calib_gain_Q8  = CALIB_DEFAULT_GAIN_Q8;
  97   1        g_calib_valid    = 0;
  98   1        return 0;
  99   1      }
