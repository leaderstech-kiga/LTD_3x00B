1424          void Uart_Out_Fire(uint16_t Value){
1425   1      
1426   1        Port_SetAlterFunctionpin(PORT1, PIN2, 0x1);
1427   1      
1428   1        /* This runs right after fire-voice playback (play_fire_burst -> Audio_Run),
1429   1         * which left the USART block in SPI (synchronous) mode. USART_Initial()
1430   1         * skips its block reset when coming from synchronous mode - its reset is
1431   1         * gated on (USTCR1 bit6 == 0) - so force SOFTRST here to cleanly switch the
1432   1         * block back to UART. Without this the first UART output after audio is
1433   1         * garbled / dropped. */
1434   1        USTST |= SOFTRST;
1435   1      
1436   1        USART_Initial(9600, USART_DATA_8BIT, USART_STOP_1BIT, USART_PARITY_NO, USART_TX_RX_MODE);
1437   1        
1438   1        if(ADC_mode == Dust_mode){
1439   2          
1440   2          if(visual_type == 1){
1441   3            USART_SendDataWithPolling(&Visu_MODE, sizeof(Visu_MODE));
1442   3          }
1443   2          else{
1444   3            USART_SendDataWithPolling(&Dust_MODE, sizeof(Dust_MODE));
1445   3          }
1446   2          USART_SendDataWithPolling(&Space, sizeof(Space));
1447   2          USART_SendDataWithPolling(&Dust_val, sizeof(Dust_val));
1448   2          USART_SendDataWithPolling(&Space, sizeof(Space));
1449   2          Uart_Out_Int(Value);
1450   2      
1451   2        }
1452   1        else if(ADC_mode == Temp_mode){
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 25  

1453   2          USART_SendDataWithPolling(&Temp_MODE, sizeof(Temp_MODE));
1454   2          USART_SendDataWithPolling(&Space, sizeof(Space));
1455   2          Uart_Out_Int(Value);
1456   2        }
1457   1        
1458   1        USART_SendDataWithPolling(&End, 4);
1459   1        
1460   1        Port_SetAlterFunctionpin(PORT1, PIN2, 0);
1461   1      }
