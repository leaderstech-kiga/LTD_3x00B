1491          
1492          /**********************************************************************
1493           * @brief       Data_Avr - simple arithmetic mean over `count` ADC samples
1494           * @param       adc_data - pointer to array of uint16_t samples
1495           * @param       count    - number of elements (NOT bytes!)
1496           * @return      average value, or 0 if count==0
1497           **********************************************************************/
1498          uint16_t Data_Avr(uint16_t *adc_data, uint8_t count){
1499   1        
1500   1        uint32_t temp = 0;
1501   1        uint8_t i;
1502   1        
1503   1        if(count < 1){
1504   2          return 0;
1505   2        }
1506   1        
1507   1        for(i=0; i<count ; i++){
1508   2          temp = temp + adc_data[i];
1509   2        }
1510   1        
1511   1        temp = temp / count;
1512   1        
1513   1        return temp;
1514   1        
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 26  

1515   1      }
1516          
1517          void Data_Sorting(uint16_t *adc_data, uint8_t count)
1518          {
1519   1        uint8_t i,j;
1520   1        uint16_t temp;
1521   1      
1522   1        if(count < 1){
1523   2          return;
1524   2        }
1525   1        
1526   1        for(i = 0; i < (count-1); i++)
1527   1        {
1528   2          for(j = i+1; j < count; j++)
1529   2          {
1530   3            
1531   3            if(adc_data[i] > adc_data[j])
1532   3            {
1533   4              temp = adc_data[i];
1534   4              adc_data[i]=adc_data[j];
1535   4              adc_data[j]=temp;
1536   4            }
1537   3          }
1538   2        }
1539   1      }
1540          
1541          uint16_t Data_TrimmedMean(uint16_t *adc_data, uint8_t count){
1542   1      
1543   1        uint32_t temp = 0;
1544   1        uint8_t i;
1545   1        
1546   1        if(count < 3){
1547   2          return 0;
1548   2        }
1549   1        
1550   1        
1551   1        Data_Sorting(adc_data, count);
1552   1        
1553   1        for(i=1; i<(count -1) ; i++){
1554   2          temp = temp + adc_data[i];
1555   2        }
1556   1        
1557   1        temp = temp / (count -2);
1558   1        
1559   1        return temp;
1560   1        
1561   1      }
