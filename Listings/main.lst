 875          uint8_t SPI_Memory_Check(void){
 876   1        
 877   1        uint8_t SystemStatus_Read;
 878   1        uint8_t deviceID[3];
 879   1        
 880   1          // SPI Memory Check
 881   1        // CVDD_ON drives P20 = 1, which is the C_VDD signal supplying VCC to
 882   1        // U3 (MX25L1006E). P20 is a regular GPIO output (~50 ohm), so the
 883   1        // flash supply rail (C14 decoupling) charges through that impedance.
 884   1        CVDD_ON;             // P20 = 1 -> C_VDD high -> flash VCC ON
 885   1      
 886   1        // Wait for flash VCC to settle after C_VDD goes high (10 uF cap
 887   1        // on the rail charges through the P20 GPIO output impedance).
 888   1        NOP_20us_Delay(500);  // ~10 ms settle time for 10 uF flash VCC
 889   1      
 890   1        // SPI Initial
 891   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
 892   1      
 893   1        Get_Identification(deviceID);
 894   1      
 895   1        // Match expected MX25L1006E JEDEC ID + verify no SPI timeout
 896   1        // (so a 0xFF-on-each-byte timeout doesn't look like a partial match).
 897   1        if( (deviceID[0]==0xC2)&&(deviceID[1]==0x20)&&(deviceID[2]==0x11) && (SPI_Timeout == 0) )
 898   1        {
 899   2          SystemStatus_Read=1;
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 16  

 900   2        }
 901   1        else{
 902   2          SystemStatus_Read=0;
 903   2        }
 904   1      
 905   1        CVDD_OFF;
 906   1        
 907   1          if(SystemStatus_Read == 1){
 908   2          
 909   2          LED_G_ON;
 910   2          Delay_ms(50);
 911   2          LED_G_OFF;
 912   2          
 913   2        }
 914   1        else{
 915   2          
 916   2          LED_R_ON;
 917   2          Delay_ms(50);
 918   2          LED_R_OFF;
 919   2        }
 920   1        
 921   1        
 922   1        Delay_ms(100);
 923   1        LED_G_ON;
 924   1        LED_R_ON;
 925   1        Delay_ms(50);
 926   1        LED_G_OFF;
 927   1        LED_R_OFF;
 928   1        
 929   1        return SystemStatus_Read;
 930   1      }
