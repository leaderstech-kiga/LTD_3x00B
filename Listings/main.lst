1401           * @brief       Check_System - autodetect heat-vs-smoke variant.
1402           *              Probes AN3 with LDO on vs LDO off. A heat (NTC) variant
1403           *              shows a large delta; a smoke (photoelectric) variant does
1404           *              not. Returns Temp_mode or Dust_mode accordingly.
1405           **********************************************************************/
1406          uint16_t Check_System(void)
1407          {
1408   1        int V25_On_adc_data= 0 , V25_Off_adc_data= 0;
1409   1        uint16_t System_Mode_Ck;
1410   1      
1411   1        // OPAMP outputs disabled; route AN3/AN2/AN1 to ADC pins.
1412   1        P0FSRL  = 0
1413   1          | ( 2 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used          // SENSING IN ADC
1414   1          | ( 2 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used              // Temperature_ADC
1415   1          | ( 2<< 2)        //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used        //
1416   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used      // C_VDD
1417   1      
1418   1        OP0_Enable(FALSE);
1419   1        OP1_Enable(FALSE);
1420   1        LDO_ON;
1421   1        ADC_Initial(ADC_CLK_1M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF + LDO_ON sequence isola
             -tes heat-variant signal
1422   1        ADC_SelectChannel(ADC_CH3);
1423   1        
1424   1        Delay_ms(1);
1425   1        
1426   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1427   1        
1428   1        LDO_OFF;
1429   1      
1430   1        V25_On_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1431   1        
1432   1        Delay_ms(20);
1433   1        
1434   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1435   1        V25_Off_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1436   1      
1437   1        if( abs(V25_On_adc_data - V25_Off_adc_data) > System_Ck_Value){
1438   2          System_Mode_Ck = Temp_mode;
1439   2        }
1440   1        else{
1441   2          System_Mode_Ck = Dust_mode;
1442   2        }
1443   1      
1444   1        /* Cleanup: disable ADC + restore P0FSRL to hw_initial baseline so the
1445   1         * caller does not inherit an active ADC block or AN3/AN2/AN1 pin mode. */
1446   1        ADCCRL = 0x00;
1447   1        P0FSRL = 0
1448   1          | (1 << 6)        /* P03 = OP0OUT (hw_initial baseline) */
1449   1          | (1 << 4)        /* P02 = OP1P                          */
1450   1          | (1 << 2)        /* P01 = OP1N                          */
1451   1          | (0 << 0);       /* P00 = I/O                           */
1452   1      
1453   1        return System_Mode_Ck;
1454   1      }
