1168   1        
1169   1          /* Audio Initial */
1170   1        Audio_Initial();  
1171   1        
1172   1        NOP_20us_Delay(1000);         // 0.02sec
1173   1        NOP_20us_Delay(1000);         // 0.02sec
1174   1        NOP_20us_Delay(1000);         // 0.02sec
1175   1        
1176   1        
1177   1        Timer1_Start();
1178   1      
1179   1        // Audio clips run ~3 seconds (Audio3_length=24324 samples @ 8 kHz =
1180   1        // 3.04 s) which exceeds the 2-s active-mode WDT timeout. Refresh the
1181   1        // watchdog inside this polling loop so playback is not aborted by a
