1691          /**********************************************************************
1692           * @brief   Dust_1ADC
1693           * @param     None
1694           * @return  None
1695           **********************************************************************/
1696          
1697          uint16_t Dust_ADC_1AMP(void)
1698          {
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 29  

1699   1        uint16_t Dust_adc_data = 0;
1700   1        uint32_t adc_avg;
1701   1        uint32_t op;
1702   1      
1703   1        /* Pin function map - same as 2AMP for consistency */
1704   1        P0FSRL  = 0
1705   1          | ( 1 << 6)       /* P03 : OP0OUT (sensing OP-amp output to ADC) */
1706   1          | ( 1 << 4)       /* P02 : OP1P  (unused here)                    */
1707   1          | ( 2 << 2)       /* P01 : AN1   (battery ADC channel)            */
1708   1          | ( 1 << 0);      /* P00 : OP1OUT (test point)                    */
1709   1      
1710   1        OPAMP_Initial(GAIN1_DIS, GAIN0_DIS, chp_125KHz);
1711   1        OP0_Enable(TRUE);
1712   1        OP1_Enable(FALSE);
1713   1      
1714   1        ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);
1715   1        ADC_SelectChannel(ADC_VBGR);
1716   1        Delay_ms(1);
1717   1      
1718   1        /* 1) VBGR measurement -> ratiometric battery compensation factor.
1719   1         * ADC1_Bat_Val ~= 300 at VBAT=3V; used to scale the OP0OUT readings
1720   1         * so dust results stay constant across battery voltage drift. */
1721   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1722   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1723   1        if (adc_avg == 0) {
1724   2          goto cleanup;          /* divide-by-zero guard */
1725   2        }
1726   1        op  = 92;
1727   1        op *= 1024;
1728   1        op /= adc_avg;
1729   1        ADC1_Bat_Val = op;
1730   1      
1731   1        /* 2) LED ON - chamber sensing.
1732   1         * No divide-by-zero possible here (multiplication only, /1024 is the
1733   1         * only division). adc_avg=0 is a legitimate dark-chamber reading. */
1734   1        LDO_ON;
1735   1        ADC_SelectChannel(ADC_OP0OUT);
1736   1        Delay_ms(1);
1737   1      
1738   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1739   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1740   1      
1741   1        LDO_OFF;
1742   1        Delay_ms(1);
1743   1      
1744   1        op  = ADC1_Bat_Val;
1745   1        op *= adc_avg;
1746   1        op /= 1024;
1747   1        ADC1_On_Dust_Val = op;
1748   1      
1749   1        /* 3) LED OFF - ambient reference (still on ADC_OP0OUT) */
1750   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1751   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1752   1      
1753   1        op  = ADC1_Bat_Val;
1754   1        op *= adc_avg;
1755   1        op /= 1024;
1756   1        ADC1_Off_Dust_Val = op;
1757   1      
1758   1        /* Underflow guard: if optical noise pushes Off > On the uint16_t
1759   1         * subtraction would wrap to ~65535 and trigger a false fire alarm.
1760   1         * Treat that case as zero dust signal. */
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 30  

1761   1        if (ADC1_On_Dust_Val > ADC1_Off_Dust_Val) {
1762   2          Dust_adc_data = ADC1_On_Dust_Val - ADC1_Off_Dust_Val;
1763   2        } else {
1764   2          Dust_adc_data = 0;
1765   2        }
1766   1      
1767   1      cleanup:
1768   1        /* Disable ADC + OPAMP + restore P0FSRL to hw_initial baseline so the
1769   1         * next call (or BeforeStop) inherits a clean state. */
1770   1        ADCCRL = 0x00;
1771   1        OP0_Enable(FALSE);
1772   1        OP1_Enable(FALSE);
1773   1        AMPCR1 = 0x00;
1774   1        P0FSRL = 0
1775   1          | (1 << 6)        /* P03 = OP0OUT (baseline) */
1776   1          | (1 << 4)        /* P02 = OP1P              */
1777   1          | (1 << 2)        /* P01 = OP1N              */
1778   1          | (0 << 0);       /* P00 = I/O               */
1779   1      
1780   1        return Dust_adc_data;
1781   1      }
