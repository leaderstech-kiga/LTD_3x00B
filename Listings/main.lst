C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 19  

1086           * @brief   WD_Reset - configure WDT in RESET mode for hang protection.
1087           *
1088           *   Purpose: while the MCU is awake and executing code, the WDT must be
1089           *   armed in RESET mode so that any hang (stuck SPI poll, infinite loop,
1090           *   ISR deadlock, EMI-induced PC corruption, etc.) triggers an automatic
1091           *   MCU reset rather than leaving the device silently dead. Safety-
1092           *   critical for a fire detector.
1093           *
1094           *   The complementary wake-from-Stop timer (BeforeStop) keeps WDT in
1095           *   INTERRUPT mode with WDTDR=2 (~0.192 s). On every wake we call this
1096           *   function to switch WDT into RESET mode with the longer timeout;
1097           *   BeforeStop will switch it back before the next Stop.
1098           *
1099           *   Behaviour:
1100           *     - Clock source : WDTRC (~3.072 MHz internal, independent of MCLK)
1101           *     - Timeout      : WDTDR = 30  ->  approximately 2 seconds.
1102           *                      Long enough to cover normal active code paths
1103           *                      (Dust_ADC_Single, Delay_ms(100), hw_initial_Wait,
1104           *                      etc.); shorter than the time a real hang would
1105           *                      take to be noticeable. Longer blocking calls
1106           *                      (Audio_Run audio playback, Fire_Alarm loop) must
1107           *                      refresh the counter by calling WD_Reset()
1108           *                      themselves - see those functions below.
1109           *     - Mode         : RESET (WDTCR bit 6 set) -> MCU reset on overflow.
1110           *
1111           *   Note: WDTCR also has bit 5 (WDTCL) set, which clears the counter on
1112           *   every write, so each WD_Reset() call effectively "kicks the dog".
1113           **********************************************************************/
1114          void WD_Reset(void)
1115          {
1116   1        WDTDR = 30;                       // ~2 sec active-mode timeout
1117   1        //WDTCR = 0xA3;                     // set WDT enable , clock source LFIRC, WDT interrupt
1118   1        //WDTCR = 0xE5;                     // WDT enable, RESET mode (bit6=1), WDTRC clock, clear counter
1119   1        WDTCR = 0xE3;     /* 11100011: WDTEN=1, RESET mode, WDTCL=1, WDTCK=01 (LFIRC) */
1120   1        IE3 |= 0x08;                      // WDT interrupt enable (no effect in reset mode but harmless)
1121   1      }
1122          
1123          void WDT_Int(void) interrupt WDT_VECT
1124          {
1125   1        WDTCR &= ~0x01;
1126   1      }
