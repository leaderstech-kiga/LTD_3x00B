 260          /*----------------------------------------------------------------------------*
 261           * Main-loop procedure constants + helpers (see docs/main_loop_design.md).    *
 262           *   Wake tick = 0.192 s (WDT INTERRUPT mode); periodic tasks use system_count *
 263           *   modulo. EMR_IO = P10 (PORT1/PIN0): driven high when THIS unit alarms,     *
 264           *   read as input for the external interlock line.                           *
 265           *----------------------------------------------------------------------------*/
 266          #define FIRE_CHECK_CNT        42u    /* STEP1 fire monitor   : 42  wakes ~8.06 s   */
 267          #define LED_BAT_CNT           292u   /* STEP2 LED + battery  : 292 wakes ~56.06 s  */
 268          #define LOWBAT_ALARM_CNT      1458u  /* STEP3 low-bat repeat : 1458 wakes ~279.9 s */
 269          #define FIRE_CONFIRM_SAMPLES  4u     /* STEP1 averaged confirm readings            */
 270          #define FIRE_BLINK_MS         100u   /* pre-alarm blink half-period (0.1 s -> 0.2 s)*/
 271          #define FIRE_GAP_TOGGLES      10u    /* pre-alarm blinks per gap (10*0.1=1 s, 4=4 s)*/
 272          #define FIRE_VOICE_REPEAT     3u     /* fire clip plays per alarm burst            */
 273          #define FIRE_VOICE_GAP_MS     300u   /* gap between fire-clip plays (0.3 s)        */
 274          #define FIRE_RECHECK_HALF_MS  250u   /* fire-loop re-confirm blink half (0.25 s)   */
 275          #define FIRE_RECHECK_TOGGLES  2u     /* re-confirm toggles/sample (2*0.25=0.5 s, 4=2 s)*/
 276          #define BAT_LOW_CV            265u   /* enter low-battery at <= 2.65 V             */
 277          #define BAT_RECOVER_CV        275u   /* exit  low-battery at >= 2.75 V (hysteresis)*/
 278          
 279          /* WDT-safe blocking wait (RESET-mode WDT ~2 s) in 100 ms chunks. */
 280          static void loop_wait_ms(uint16_t ms)
 281          {
 282   1        while (ms >= 100) { WD_Reset(); Delay_ms(100); ms -= 100; }
 283   1        if (ms)          { WD_Reset(); Delay_ms(ms);              }
 284   1      }
 285          
 286          /* STEP1 helper: takes FIRE_CONFIRM_SAMPLES normalized Dust readings and
 287           * returns the mean. Between samples LED_R blinks (half_ms on/off) for
 288           * `toggles` half-cycles, so the per-sample gap = toggles*half_ms and the
 289           * total window = FIRE_CONFIRM_SAMPLES * toggles * half_ms.
 290           *   pre-alarm    : (100 ms, 10) -> 0.2 s blink, 1 s/sample, 4 s total
 291           *   fire re-check: (250 ms,  2) -> 0.5 s blink, 0.5 s/sample, 2 s total
 292           * Timer2 is left off here so its ISR cannot perturb the dust ADC sampling. */
 293          static uint16_t fire_confirm_avg(uint16_t half_ms, uint8_t toggles)
 294          {
 295   1        uint32_t sum = 0;
 296   1        uint8_t  i, t;
 297   1        for (i = 0; i < FIRE_CONFIRM_SAMPLES; i++) {
 298   2          ADC2_Dust_Val      = Dust_ADC_2AMP();
 299   2          ADC2_Dust_Val_Norm = calib_apply(ADC2_Dust_Val);
 300   2          sum += ADC2_Dust_Val_Norm;
 301   2          for (t = 0; t < toggles; t++) {
 302   3            if (t & 0x01) { LED_R_OFF; } else { LED_R_ON; }
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 6   

 303   3            WD_Reset();
 304   3            Delay_ms(half_ms);
 305   3          }
 306   2        }
 307   1        LED_R_OFF;
 308   1        return (uint16_t)(sum / FIRE_CONFIRM_SAMPLES);
 309   1      }
 310          
 311          /* Fire LED_R blink via Timer2 ISR (0.2 s period, 0.1 s on/off). Lets LED_R
 312           * keep blinking even while a blocking Play_Clip() runs: audio plays on the
 313           * Timer1 ISR, so global interrupts are enabled during playback and Timer2
 314           * fires too. */
 315          static void fire_led_blink_start(void)
 316          {
 317   1        T2_init();
 318   1        Fire_Alarm_LED = 1;
 319   1        Timer2_Start();
 320   1      }
 321          static void fire_led_blink_stop(void)
 322          {
 323   1        Timer2_Stop();
 324   1        Fire_Alarm_LED = 0;
 325   1        LED_R_OFF;
 326   1      }
 327          
 328          /* Play the fire-alarm clip FIRE_VOICE_REPEAT times, FIRE_VOICE_GAP_MS (0.3 s)
 329           * apart. When with_led is set, LED_R blinks at 0.2 s (Timer2) for the whole
 330           * burst; otherwise LED_R is kept off (STEP 4 external-interlock case). */
 331          static void play_fire_burst(uint8_t with_led)
 332          {
 333   1        uint8_t i;
 334   1        if (with_led) { fire_led_blink_start(); }
 335   1        for (i = 0; i < FIRE_VOICE_REPEAT; i++) {
 336   2          Play_Clip(AUDIO_CLIP_FIRE);   /* ~3 s, self-kicks WDT */
 337   2          loop_wait_ms(FIRE_VOICE_GAP_MS);
 338   2        }
 339   1        if (with_led) { fire_led_blink_stop(); }
 340   1        else          { LED_R_OFF;            }
 341   1      }
 342          
 343          /* STEP2/3 helper: read battery, update Bat_mode with hysteresis, and fire
 344           * the immediate low-battery voice on the High->Low transition. */
 345          static void battery_check(void)
 346          {
 347   1        ADC_Bat_Val = Get_Bat_Voltage_cV();
 348   1        if (Bat_mode != Bat_Low_mode) {
 349   2          if (ADC_Bat_Val <= BAT_LOW_CV) {
 350   3            Bat_mode = Bat_Low_mode;
 351   3            Play_Clip(AUDIO_CLIP_LOWBAT);   /* STEP3: immediate 1x on entry */
 352   3          }
 353   2        } else {
 354   2          if (ADC_Bat_Val >= BAT_RECOVER_CV) {
 355   3            Bat_mode = Bat_High_mode;
 356   3          }
 357   2        }
 358   1      }
