1657          /**********************************************************************
1658           * @brief   Dust_1ADC
1659           * @param     None
1660           * @return  None
1661           **********************************************************************/
1662          
1663          uint16_t Dust_ADC_1AMP(void)
1664          {
1665   1        uint16_t Dust_adc_data = 0;
1666   1        uint32_t adc_avg;
1667   1        uint32_t op;
1668   1      
1669   1        /* Pin function map - same as 2AMP for consistency */
1670   1        P0FSRL  = 0
1671   1          | ( 1 << 6)       /* P03 : OP0OUT (sensing OP-amp output to ADC) */
1672   1          | ( 1 << 4)       /* P02 : OP1P  (unused here)                    */
1673   1          | ( 2 << 2)       /* P01 : AN1   (battery ADC channel)            */
1674   1          | ( 1 << 0);      /* P00 : OP1OUT (test point)                    */
1675   1      
1676   1        OPAMP_Initial(GAIN1_DIS, GAIN0_DIS, chp_125KHz);
1677   1        OP0_Enable(TRUE);
1678   1        OP1_Enable(FALSE);
1679   1      
1680   1        ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);
1681   1        ADC_SelectChannel(ADC_VBGR);
1682   1        Delay_ms(1);
1683   1      
1684   1        /* 1) VBGR measurement -> ratiometric battery compensation factor.
1685   1         * ADC1_Bat_Val ~= 300 at VBAT=3V; used to scale the OP0OUT readings
1686   1         * so dust results stay constant across battery voltage drift. */
1687   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1688   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1689   1        if (adc_avg == 0) {
1690   2          goto cleanup;          /* divide-by-zero guard */
1691   2        }
1692   1        op  = 92;
1693   1        op *= 1024;
1694   1        op /= adc_avg;
1695   1        ADC1_Bat_Val = op;
1696   1      
1697   1        /* 2) LED ON - chamber sensing.
1698   1         * No divide-by-zero possible here (multiplication only, /1024 is the
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 29  

1699   1         * only division). adc_avg=0 is a legitimate dark-chamber reading. */
1700   1        LDO_ON;
1701   1        ADC_SelectChannel(ADC_OP0OUT);
1702   1        Delay_ms(1);
1703   1      
1704   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1705   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1706   1      
1707   1        LDO_OFF;
1708   1        Delay_ms(1);
1709   1      
1710   1        op  = ADC1_Bat_Val;
1711   1        op *= adc_avg;
1712   1        op /= 1024;
1713   1        ADC1_On_Dust_Val = op;
1714   1      
1715   1        /* 3) LED OFF - ambient reference (still on ADC_OP0OUT) */
1716   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1717   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1718   1      
1719   1        op  = ADC1_Bat_Val;
1720   1        op *= adc_avg;
1721   1        op /= 1024;
1722   1        ADC1_Off_Dust_Val = op;
1723   1      
1724   1        /* Underflow guard: if optical noise pushes Off > On the uint16_t
1725   1         * subtraction would wrap to ~65535 and trigger a false fire alarm.
1726   1         * Treat that case as zero dust signal. */
1727   1        if (ADC1_On_Dust_Val > ADC1_Off_Dust_Val) {
1728   2          Dust_adc_data = ADC1_On_Dust_Val - ADC1_Off_Dust_Val;
1729   2        } else {
1730   2          Dust_adc_data = 0;
1731   2        }
1732   1      
1733   1      cleanup:
1734   1        /* Disable ADC + OPAMP + restore P0FSRL to hw_initial baseline so the
1735   1         * next call (or BeforeStop) inherits a clean state. */
1736   1        ADCCRL = 0x00;
1737   1        OP0_Enable(FALSE);
1738   1        OP1_Enable(FALSE);
1739   1        AMPCR1 = 0x00;
1740   1        P0FSRL = 0
1741   1          | (1 << 6)        /* P03 = OP0OUT (baseline) */
1742   1          | (1 << 4)        /* P02 = OP1P              */
1743   1          | (1 << 2)        /* P01 = OP1N              */
1744   1          | (0 << 0);       /* P00 = I/O               */
1745   1      
1746   1        return Dust_adc_data;
1747   1      }
