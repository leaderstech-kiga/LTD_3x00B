1810   1      
1811   1        op  = ADC2_Bat_Val;
1812   1        op *= adc_avg;
1813   1        op /= 1024;
1814   1        ADC2_On_Dust_Val = op;
1815   1      
1816   1        /* 3) LED OFF - ambient reference (still on ADC_OP1OUT) */
1817   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1818   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1819   1      
1820   1        op  = ADC2_Bat_Val;
1821   1        op *= adc_avg;
1822   1        op /= 1024;
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 31  

1823   1        ADC2_Off_Dust_Val = op;
1824   1      
1825   1        /* Underflow guard - same rationale as Dust_ADC_1AMP */
1826   1        if (ADC2_On_Dust_Val > ADC2_Off_Dust_Val) {
