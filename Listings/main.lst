1563          /**********************************************************************
1564           * @brief       Check_System - autodetect heat-vs-smoke variant.
1565           *              Probes AN3 with LDO on vs LDO off. A heat (NTC) variant
1566           *              shows a large delta; a smoke (photoelectric) variant does
1567           *              not. Returns Temp_mode or Dust_mode accordingly.
1568           **********************************************************************/
1569          uint16_t Check_System(void)
1570          {
1571   1        int V25_On_adc_data= 0 , V25_Off_adc_data= 0;
1572   1        uint16_t System_Mode_Ck;
1573   1      
1574   1        // OPAMP outputs disabled; route AN3/AN2/AN1 to ADC pins.
1575   1        P0FSRL  = 0
1576   1          | ( 2 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used          // SENSING IN ADC
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 27  

1577   1          | ( 2 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used              // Temperature_ADC
1578   1          | ( 2<< 2)        //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used        //
1579   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used      // C_VDD
1580   1      
1581   1        OP0_Enable(FALSE);
1582   1        OP1_Enable(FALSE);
1583   1        LDO_ON;
1584   1        ADC_Initial(ADC_CLK_1M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF + LDO_ON sequence isola
             -tes heat-variant signal
1585   1        ADC_SelectChannel(ADC_CH3);
1586   1        
1587   1        Delay_ms(1);
1588   1        
1589   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1590   1        
1591   1        LDO_OFF;
1592   1      
1593   1        V25_On_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1594   1        
1595   1        Delay_ms(20);
1596   1        
1597   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1598   1        V25_Off_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1599   1      
1600   1        if( abs(V25_On_adc_data - V25_Off_adc_data) > System_Ck_Value){
1601   2          System_Mode_Ck = Temp_mode;
1602   2        }
1603   1        else{
1604   2          System_Mode_Ck = Dust_mode;
1605   2        }
1606   1      
1607   1        /* Cleanup: disable ADC + restore P0FSRL to hw_initial baseline so the
1608   1         * caller does not inherit an active ADC block or AN3/AN2/AN1 pin mode. */
1609   1        ADCCRL = 0x00;
1610   1        P0FSRL = 0
1611   1          | (1 << 6)        /* P03 = OP0OUT (hw_initial baseline) */
1612   1          | (1 << 4)        /* P02 = OP1P                          */
1613   1          | (1 << 2)        /* P01 = OP1N                          */
1614   1          | (0 << 0);       /* P00 = I/O                           */
1615   1      
1616   1        return System_Mode_Ck;
1617   1      }
