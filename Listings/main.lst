 366          /**********************************************************************
 367           * @brief   main - standard C program entry point.
 368           * @param   None
 369           * @return  None
 370           **********************************************************************/
 371          void main(void)
 372          {
 373   1      
 374   1        //LDO_OFF;
 375   1        //CVDD_OFF;
 376   1        //AUDIO_OFF;
 377   1        system_count = 0;
 378   1        uart_debug_mode = uart_debug_On;
 379   1      
 380   1        hw_initial_Wait(10);
 381   1      
 382   1       SystemStatus = SPI_Memory_Check();
 383   1      
 384   1        ADC_mode = Check_System();
 385   1      
 386   1        hw_initial_Wait(10);
 387   1        system_count = 0;
 388   1      
 389   1        SYS_mode =  Normal_mode;
 390   1      
 391   1        /* Boot / calibration initialisation (matches the existing product family).
 392   1         *
 393   1         *   STEP 1 - Power-on indication.
 394   1         *     calib_step1_boot_led(): LED_G + LED_R on together for 0.2 s.
 395   1         *
 396   1         *   STEP 2-1 - Flash erase + baseline capture (SW2 held at power-up).
 397   1         *     calib_erase_with_animation(): alternate G/R while held; on
 398   1         *     release erase the page, capture one clean-air baseline, save
 399   1         *     {baseline, gain=256} and set g_calib_needs_smoke = 1.
 400   1         *
 401   1         *   STEP 2-2 - Load (SW2 not held at power-up).
 402   1         *     calib_boot_init(): load baseline / gain_Q8 from DataFlash.
 403   1         *
 404   1         *   STEP 3 - Smoke gain calibration.
 405   1         *     Lives in the main loop (see the SW2 hold handler below):
 406   1         *     LED_R + release wait + place phase + 5-sample mean + gain save.
 407   1         */
 408   1      
 409   1        Port_SetInputpin(PORT1, PIN2, 1);
 410   1      
 411   1        /* STEP 1: power-on indication. */
 412   1        calib_step1_boot_led();
 413   1        
 414   1        if(uart_debug_mode == uart_debug_On){
 415   2          Uart_Out_Text( Boot_OK,11);
 416   2        }
 417   1      
 418   1      
 419   1        Delay_ms(300);
 420   1        if (Port_GetInputpinValue(PORT1, PIN2) == 0) {
 421   2          /* STEP 2-1: SW2 held -> erase + capture baseline + save. */
 422   2          calib_erase_with_animation();
 423   2        } else {
 424   2          /* STEP 2-2: SW2 not held -> load saved calibration. */
 425   2          calib_boot_init();
 426   2        }
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 8   

 427   1        
 428   1        /* STEP 2 once before entering the loop (power LED + battery check). */
 429   1        Bat_mode = Bat_High_mode;
 430   1        LED_R_ON;
 431   1        Delay_ms(200);
 432   1        LED_R_OFF;
 433   1        battery_check();
 434   1        system_count = 1;   /* avoid count==0 immediately re-triggering STEP1/2 */
 435   1      
 436   1        hw_initial_Wait(10);
 437   1          while(1)
 438   1        {
 439   2      
 440   2          // Arm RESET-mode WDT (~2 s timeout) at the top of every loop
 441   2          // iteration for active-code hang protection. BeforeStop() swaps
 442   2          // it back to INTERRUPT mode before Stop() so the wake timer
 443   2          // still works.
 444   2          WD_Reset();
 445   2      
 446   2      
 447   2        // =====================================================================
 448   2        // Main-loop procedure (STEP 1..5) - see docs/main_loop_design.md
 449   2        // Base wake/sleep behaviour: docs/wdt_periodic_v3.md
 450   2        // =====================================================================
 451   2      
 452   2          
 453   2        // STEP 1 - Fire monitoring (every FIRE_CHECK_CNT wakes, ~8.06 s)
 454   2        //////////////////////////////////////////////////////////////////////////////////////////
 455   2          if (system_count % FIRE_CHECK_CNT == 0) {
 456   3      
 457   3            ADC2_Dust_Val      = Dust_ADC_2AMP();
 458   3            ADC2_Dust_Val_Norm = calib_apply(ADC2_Dust_Val);
 459   3      
 460   3            if (uart_debug_mode == uart_debug_On) {
 461   4              ADC_Bat_Val = Get_Bat_Voltage_cV();
 462   4              Uart_Out();
 463   4            }
 464   3      
 465   3            if (ADC2_Dust_Val_Norm >= CALIB_ALARM_THRESHOLD) {
 466   4              /* Pre-alarm: confirm with a 4-sample average (0.2 s blink, ~4 s). */
 467   4              uint16_t smoke_avg = fire_confirm_avg(FIRE_BLINK_MS, FIRE_GAP_TOGGLES);
 468   4      
 469   4              if (smoke_avg >= CALIB_ALARM_THRESHOLD) {
 470   5                /* Confirmed fire: drive EMR_IO high, alarm until cleared. */
 471   5                Port_SetOutputpin(PORT1, PIN0, 0);
 472   5                P10 = 1;
 473   5      
 474   5                do {
 475   6                  /* voice: FIRE x3, 0.3 s apart, LED_R 0.2 s blink (Timer2) */
 476   6                  play_fire_burst(1);
