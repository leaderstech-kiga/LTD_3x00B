1651          /**********************************************************************
1652           * @brief       Get_Bat_Voltage_cV - measure battery voltage in units of
1653           *              0.01 V (e.g. return value 304 == 3.04 V).
1654           *              Reads the internal VBGR reference against VDD as ADC ref
1655           *              (ratiometric trick): VBGR_CV is the calibrated bandgap *100,
1656           *              ADC_FS = 1024 (10-bit FS), and the formula
1657           *                  Vbat_cv = (VBGR_CV * ADC_FS) / adc_reading
1658           *              gives Vbat in centivolts.
1659           **********************************************************************/
1660          uint16_t Get_Bat_Voltage_cV(void)   // unit: 0.01 V
1661          {
1662   1          uint32_t adc_avg;
1663   1          uint32_t vbat_cv;
1664   1      
1665   1      
1666   1          ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF reads VBGR against 
             -VDD - ratiometric Vbat math
1667   1          ADC_SelectChannel(ADC_VBGR);
1668   1          Delay_ms(1);
1669   1      
1670   1          ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1671   1      
1672   1          adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1673   1      
1674   1          if (adc_avg == 0) {
1675   2              ADCCRL = 0x00;            /* cleanup before early return */
1676   2              return 0;
1677   2          }
1678   1      
1679   1          vbat_cv = ((uint32_t)VBGR_CV * ADC_FS) / adc_avg;
1680   1      
1681   1          // sanity clamp (optional)
1682   1          if (vbat_cv > 400) vbat_cv = 400;   // ignore impossible >4.00 V readings
1683   1      
1684   1          /* Cleanup: disable ADC module. (P0FSRL untouched - this function does
1685   1           * not change pin functions.) */
1686   1          ADCCRL = 0x00;
1687   1      
1688   1          return (uint16_t)vbat_cv;
1689   1      }
