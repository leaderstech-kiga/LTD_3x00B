1139          /**********************************************************************
1140           * @brief   WD_Reset - configure WDT in RESET mode for hang protection.
1141           *
1142           *   Purpose: while the MCU is awake and executing code, the WDT must be
1143           *   armed in RESET mode so that any hang (stuck SPI poll, infinite loop,
1144           *   ISR deadlock, EMI-induced PC corruption, etc.) triggers an automatic
1145           *   MCU reset rather than leaving the device silently dead. Safety-
1146           *   critical for a fire detector.
1147           *
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 20  

1148           *   The complementary wake-from-Stop timer (BeforeStop) keeps WDT in
1149           *   INTERRUPT mode with WDTDR=2 (~0.192 s). On every wake we call this
1150           *   function to switch WDT into RESET mode with the longer timeout;
1151           *   BeforeStop will switch it back before the next Stop.
1152           *
1153           *   Behaviour:
1154           *     - Clock source : WDTRC (~3.072 MHz internal, independent of MCLK)
1155           *     - Timeout      : WDTDR = 30  ->  approximately 2 seconds.
1156           *                      Long enough to cover normal active code paths
1157           *                      (Dust_ADC_Single, Delay_ms(100), hw_initial_Wait,
1158           *                      etc.); shorter than the time a real hang would
1159           *                      take to be noticeable. Longer blocking calls
1160           *                      (Audio_Run audio playback, Fire_Alarm loop) must
1161           *                      refresh the counter by calling WD_Reset()
1162           *                      themselves - see those functions below.
1163           *     - Mode         : RESET (WDTCR bit 6 set) -> MCU reset on overflow.
1164           *
1165           *   Note: WDTCR also has bit 5 (WDTCL) set, which clears the counter on
1166           *   every write, so each WD_Reset() call effectively "kicks the dog".
1167           **********************************************************************/
1168          void WD_Reset(void)
1169          {
1170   1        WDTDR = 30;                       // ~2 sec active-mode timeout
1171   1        //WDTCR = 0xA3;                     // set WDT enable , clock source LFIRC, WDT interrupt
1172   1        //WDTCR = 0xE5;                     // WDT enable, RESET mode (bit6=1), WDTRC clock, clear counter
1173   1        WDTCR = 0xE3;     /* 11100011: WDTEN=1, RESET mode, WDTCL=1, WDTCK=01 (LFIRC) */
1174   1        IE3 |= 0x08;                      // WDT interrupt enable (no effect in reset mode but harmless)
1175   1      }
1176          
1177          void WDT_Int(void) interrupt WDT_VECT
1178          {
1179   1        WDTCR &= ~0x01;
1180   1      }
