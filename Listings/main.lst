1227          /**********************************************************************
1228           * @brief   Audio_Run
1229           * @param     None
1230           * @return  None
1231           **********************************************************************/
1232          void Audio_Run(uint16_t Address , uint16_t Length,  uint8_t Run_time){
1233   1           
1234   1        CVDD_ON;
1235   1        AUDIO_ON; 
1236   1        
1237   1        Audio_start = 1;
1238   1      
1239   1        P2 = 0x01;
1240   1        /* SPI Initial */
1241   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
1242   1        
1243   1        NOP_20us_Delay(5000);         // 0.1sec
1244   1        NOP_20us_Delay(5000);         // 0.1sec
1245   1        NOP_20us_Delay(5000);         // 0.1sec
1246   1        
1247   1        Audio_max_length = Length;
1248   1        Variable_Initial(Address);
1249   1        
1250   1          /* Audio Initial */
1251   1        Audio_Initial();  
1252   1        
1253   1        NOP_20us_Delay(1000);         // 0.02sec
1254   1        NOP_20us_Delay(1000);         // 0.02sec
1255   1        NOP_20us_Delay(1000);         // 0.02sec
1256   1        
1257   1        
1258   1        Timer1_Start();
1259   1      
1260   1        // Audio clips run ~3 seconds (Audio3_length=24324 samples @ 8 kHz =
1261   1        // 3.04 s) which exceeds the 2-s active-mode WDT timeout. Refresh the
1262   1        // watchdog inside this polling loop so playback is not aborted by a
1263   1        // false WDT reset. The CPU is otherwise idle here while the
1264   1        // TIMER1_Int ISR feeds samples in the background.
1265   1        //
1266   1        // Stall detector.
1267   1        //
1268   1        // The WD_Reset() inside this loop also means the active-mode WDT will
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 22  

1269   1        // NEVER fire here, even if the audio ISR stops making progress
1270   1        // (Audio_length not incrementing because of e.g. SPI fault, SPI clock
1271   1        // glitch, TIMER1_Int disabled). The loop would then spin forever and
1272   1        // the device would appear hung from the outside.
1273   1        //
1274   1        // We track Audio_length progress and bail out if it does not advance
1275   1        // for ~200 ms. At ~125 us per audio sample the ISR should increment
1276   1        // Audio_length about 1600 times during 200 ms, so 200 ms of zero
1277   1        // progress is unambiguous evidence of a stall.
1278   1        {
1279   2          uint16_t prev_length  = 0xFFFF;   /* sentinel - guaranteed != on first iter */
1280   2          uint16_t stall_count  = 0;
1281   2      
1282   2          while (Audio_length < Audio_max_length) {
1283   3            WD_Reset();                   /* kick dog during long playback */
1284   3      
1285   3            if (Audio_length == prev_length) {
1286   4              /* No progress this iteration. ~4 us per while iter at 4 MHz,
1287   4               * so 50000 iterations ~= 200 ms of no progress = stall. */
1288   4              if (++stall_count > 50000) {
1289   5                break;
1290   5              }
1291   4            } else {
1292   4              prev_length = Audio_length;
1293   4              stall_count = 0;
1294   4            }
1295   3          }
1296   2        }
1297   1      
1298   1        /* Deterministic teardown. Previously only Timer0 was stopped (inside the
1299   1         * TIMER1_Int done-branch), and Timer1 was left running. Because Audio_run
1300   1         * sets Audio_start = 0 below, leftover Timer1 ticks kept re-entering the
1301   1         * ISR prime branch every 125 us (re-asserting Read/Timer0) until the next
1302   1         * clip - harmless only because CVDD is off, but wasteful and fragile, and
1303   1         * the stall-break path left the flash CS asserted. Stop everything here so
1304   1         * teardown does not depend on a post-loop interrupt firing. */
1305   1        Timer1_Stop();     /* stop the 8 kHz sample interrupt */
1306   1        Timer0_Stop();     /* stop PWM output                 */
1307   1        SLAVEDESELECT;     /* release the audio-flash CS      */
1308   1      
1309   1        CVDD_OFF;
1310   1        AUDIO_OFF;
1311   1      
1312   1        //Port_SetOutputpin(PORT1, PIN0, 0);
1313   1        //P10 = 1;
1314   1      
1315   1        Audio_start = 0;
1316   1      }
