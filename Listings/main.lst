1330           * @brief       Data_Avr - simple arithmetic mean over `count` ADC samples
1331           * @param       adc_data - pointer to array of uint16_t samples
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 23  

1332           * @param       count    - number of elements (NOT bytes!)
1333           * @return      average value, or 0 if count==0
1334           **********************************************************************/
1335          uint16_t Data_Avr(uint16_t *adc_data, uint8_t count){
1336   1        
1337   1        uint32_t temp = 0;
1338   1        uint8_t i;
1339   1        
1340   1        if(count < 1){
1341   2          return 0;
1342   2        }
1343   1        
1344   1        for(i=0; i<count ; i++){
1345   2          temp = temp + adc_data[i];
1346   2        }
1347   1        
1348   1        temp = temp / count;
1349   1        
1350   1        return temp;
1351   1        
1352   1      }
1353          
1354          void Data_Sorting(uint16_t *adc_data, uint8_t count)
1355          {
1356   1        uint8_t i,j;
1357   1        uint16_t temp;
1358   1      
1359   1        if(count < 1){
1360   2          return;
1361   2        }
1362   1        
1363   1        for(i = 0; i < (count-1); i++)
1364   1        {
1365   2          for(j = i+1; j < count; j++)
1366   2          {
1367   3            
1368   3            if(adc_data[i] > adc_data[j])
1369   3            {
1370   4              temp = adc_data[i];
1371   4              adc_data[i]=adc_data[j];
1372   4              adc_data[j]=temp;
1373   4            }
1374   3          }
1375   2        }
1376   1      }
1377          
1378          uint16_t Data_TrimmedMean(uint16_t *adc_data, uint8_t count){
1379   1      
1380   1        uint32_t temp = 0;
1381   1        uint8_t i;
1382   1        
1383   1        if(count < 3){
1384   2          return 0;
1385   2        }
1386   1        
1387   1        
1388   1        Data_Sorting(adc_data, count);
1389   1        
1390   1        for(i=1; i<(count -1) ; i++){
1391   2          temp = temp + adc_data[i];
1392   2        }
1393   1        
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 24  

1394   1        temp = temp / (count -2);
1395   1        
1396   1        return temp;
1397   1        
1398   1      }
