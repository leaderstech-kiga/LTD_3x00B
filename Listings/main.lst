1301          void Uart_Out_Int(uint16_t Value){
1302   1      
1303   1        uint16_t int_val;
1304   1        uint8_t tmp;
1305   1        
1306   1        if(Value > 9999){
1307   2          Value = 9999;
1308   2        }
1309   1        
1310   1        tmp = Value / 1000 + 48;
1311   1        USART_SendDataWithPolling(&tmp, 1);
1312   1        int_val= Value % 1000 ;
1313   1        tmp = (int_val/ 100 )+ 48;
1314   1        USART_SendDataWithPolling(&tmp, 1);
1315   1        int_val= Value % 100 ;
1316   1        tmp = (int_val/ 10 )+ 48;
1317   1        USART_SendDataWithPolling(&tmp, 1);
1318   1        int_val= Value % 10 ;
1319   1        tmp = (int_val/ 1) + 48;
1320   1        USART_SendDataWithPolling(&tmp, 1);
1321   1      }
