 390          /* STEP2/3 helper: read battery, update Bat_mode with hysteresis, and fire
 391           * the immediate low-battery voice on the High->Low transition. */
 392          static void battery_check(void)
 393          {
 394   1        ADC_Bat_Val = Get_Bat_Voltage_cV();
 395   1        if (Bat_mode != Bat_Low_mode) {
 396   2          if (ADC_Bat_Val <= BAT_LOW_CV) {
 397   3            Bat_mode = Bat_Low_mode;
 398   3            lowbat_led_blink_start();
 399   3            Play_Clip(AUDIO_CLIP_LOWBAT);   /* STEP3: immediate 1x on entry */
 400   3            lowbat_led_blink_stop();
 401   3          }
 402   2        } else {
 403   2          if (ADC_Bat_Val >= BAT_RECOVER_CV) {
 404   3            Bat_mode = Bat_High_mode;
 405   3          }
 406   2        }
 407   1      }
 408          
 409          /* STEP1 helper: one fire-monitoring pass - sample dust, normalize, and on a
 410           * confirmed over-threshold reading drive the alarm (voice + EMR_IO + LED_R)
 411           * until the smoke clears. Called both from the periodic STEP1 schedule and,
 412           * on the production line, right after a successful smoke calibration so the
 413           * same 12% smoke injection doubles as a functional alarm test. */
 414          static void fire_monitor_step(void)
 415          {
 416   1        ADC2_Dust_Val      = Dust_ADC_2AMP();
 417   1        ADC2_Dust_Val_Norm = calib_apply(ADC2_Dust_Val);
 418   1      
 419   1        if (uart_debug_mode == uart_debug_On) {
 420   2          ADC_Bat_Val = Get_Bat_Voltage_cV();
 421   2          Uart_Out();
 422   2        }
 423   1      
 424   1        if (ADC2_Dust_Val_Norm >= CALIB_ALARM_THRESHOLD) {
 425   2          /* Pre-alarm: confirm with a 4-sample average (0.2 s blink, ~4 s). */
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 8   

 426   2          uint16_t smoke_avg = fire_confirm_avg(FIRE_BLINK_MS, FIRE_GAP_TOGGLES);
 427   2          uint8_t  ack;
 428   2      
 429   2          if (smoke_avg >= CALIB_ALARM_THRESHOLD) {
 430   3            /* Confirmed fire: sound the alarm until the smoke clears OR the user
 431   3             * acknowledges with SW2. Each cycle drives EMR_IO (P10) high while the
 432   3             * fire voice plays, then releases P10 to input and polls SW2:
 433   3             *   SW2 pressed     -> BOOT beep, then break out to the main loop
 434   3             *   SW2 not pressed -> re-monitor smoke (as before); loop if still fire */
 435   3            do {
 436   4              /* drive EMR_IO high to signal the interlock while sounding */
 437   4              Port_SetOutputpin(PORT1, PIN0, 0);
 438   4              P10 = 1;
 439   4      
 440   4              /* voice: FIRE x3, 0.3 s apart, LED_R 0.2 s blink (Timer2) */
 441   4              ack = play_fire_burst(1);   /* 1 = SW2 pressed mid-burst (abort) */
 442   4      
 443   4              /* after the fire voice: release EMR_IO to input (Hi-Z; the external
 444   4               * 220K pull-down sets the line low) */
 445   4              Port_SetInputpin(PORT1, PIN0, 0);
 446   4      
 447   4              /* SW2 pressed (mid-burst or now) -> acknowledge: BOOT beep, exit to main loop */
 448   4              if (ack || Port_GetInputpinValue(PORT1, PIN2) == 0) {
 449   5                Play_Clip(AUDIO_CLIP_BOOT);
 450   5                break;
 451   5              }
 452   4      
 453   4              /* not pressed -> re-monitor fire (as before): 4 samples,
 454   4               * 0.25 s blink, 0.5 s/sample, ~2 s */
 455   4              smoke_avg = fire_confirm_avg(FIRE_RECHECK_HALF_MS, FIRE_RECHECK_TOGGLES);
 456   4              if (uart_debug_mode == uart_debug_On) {
 457   5                Uart_Out_Fire(smoke_avg);
 458   5              }
 459   4            } while (smoke_avg >= CALIB_ALARM_THRESHOLD);
 460   3      
 461   3            /* Cleared or acknowledged: stop alarm, ensure interlock released. */
 462   3            LED_R_OFF;
 463   3            Port_SetInputpin(PORT1, PIN0, 0);
 464   3          }
 465   2        }
 466   1      }
