 921          uint8_t SPI_Memory_Check(void){
 922   1        
 923   1        uint8_t SystemStatus_Read;
 924   1        uint8_t deviceID[3];
 925   1        
 926   1          // SPI Memory Check
 927   1        // CVDD_ON drives P20 = 1, which is the C_VDD signal supplying VCC to
 928   1        // U3 (MX25L1006E). P20 is a regular GPIO output (~50 ohm), so the
 929   1        // flash supply rail (C14 decoupling) charges through that impedance.
 930   1        CVDD_ON;             // P20 = 1 -> C_VDD high -> flash VCC ON
 931   1      
 932   1        // Wait for flash VCC to settle after C_VDD goes high (10 uF cap
 933   1        // on the rail charges through the P20 GPIO output impedance).
 934   1        NOP_20us_Delay(500);  // ~10 ms settle time for 10 uF flash VCC
 935   1      
 936   1        // SPI Initial
 937   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
 938   1      
 939   1        Get_Identification(deviceID);
 940   1      
 941   1        // Match expected MX25L1006E JEDEC ID + verify no SPI timeout
 942   1        // (so a 0xFF-on-each-byte timeout doesn't look like a partial match).
 943   1        if( (deviceID[0]==0xC2)&&(deviceID[1]==0x20)&&(deviceID[2]==0x11) && (SPI_Timeout == 0) )
 944   1        {
 945   2          SystemStatus_Read=1;
 946   2        }
 947   1        else{
 948   2          SystemStatus_Read=0;
 949   2        }
 950   1      
 951   1        CVDD_OFF;
 952   1        
 953   1          if(SystemStatus_Read == 1){
 954   2          
 955   2          LED_G_ON;
 956   2          Delay_ms(50);
 957   2          LED_G_OFF;
 958   2          
 959   2        }
 960   1        else{
 961   2          
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 17  

 962   2          LED_R_ON;
 963   2          Delay_ms(50);
 964   2          LED_R_OFF;
 965   2        }
 966   1        
 967   1        
 968   1        Delay_ms(100);
 969   1        LED_G_ON;
 970   1        LED_R_ON;
 971   1        Delay_ms(50);
 972   1        LED_G_OFF;
 973   1        LED_R_OFF;
 974   1        
 975   1        return SystemStatus_Read;
 976   1      }
