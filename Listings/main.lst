 270          /*----------------------------------------------------------------------------*
 271           * Main-loop procedure constants + helpers (see docs/main_loop_design.md).    *
 272           *   Wake tick = 0.192 s (WDT INTERRUPT mode); periodic tasks use system_count *
 273           *   modulo. EMR_IO = P10 (PORT1/PIN0): driven high when THIS unit alarms,     *
 274           *   read as input for the external interlock line.                           *
 275           *----------------------------------------------------------------------------*/
 276          #define FIRE_CHECK_CNT        42u    /* STEP1 fire monitor   : 42  wakes ~8.06 s   */
 277          #define LED_BAT_CNT           292u   /* STEP2 LED + battery  : 292 wakes ~56.06 s  */
 278          #define LOWBAT_ALARM_CNT      1458u  /* STEP3 low-bat repeat : 1458 wakes ~279.9 s */
 279          #define FIRE_CONFIRM_SAMPLES  4u     /* STEP1 averaged confirm readings            */
 280          #define FIRE_BLINK_MS         100u   /* pre-alarm blink half-period (0.1 s -> 0.2 s)*/
 281          #define FIRE_GAP_TOGGLES      10u    /* pre-alarm blinks per gap (10*0.1=1 s, 4=4 s)*/
 282          #define FIRE_VOICE_REPEAT     3u     /* fire clip plays per alarm burst            */
 283          #define FIRE_VOICE_GAP_MS     300u   /* gap between fire-clip plays (0.3 s)        */
 284          #define FIRE_AMP_WARMUP_MS    150u   /* amp/CVDD pre-warm before 1st clip (cold)   */
 285          #define FIRE_RECHECK_HALF_MS  250u   /* fire-loop re-confirm blink half (0.25 s)   */
 286          #define FIRE_RECHECK_TOGGLES  2u     /* re-confirm toggles/sample (2*0.25=0.5 s, 4=2 s)*/
 287          #define BAT_LOW_CV            265u   /* enter low-battery at <= 2.65 V             */
 288          #define BAT_RECOVER_CV        275u   /* exit  low-battery at >= 2.75 V (hysteresis)*/
 289          
 290          /* WDT-safe blocking wait (RESET-mode WDT ~2 s) in 100 ms chunks. */
 291          static void loop_wait_ms(uint16_t ms)
 292          {
 293   1        while (ms >= 100) { WD_Reset(); Delay_ms(100); ms -= 100; }
 294   1        if (ms)          { WD_Reset(); Delay_ms(ms);              }
 295   1      }
 296          
 297          /* STEP1 helper: takes FIRE_CONFIRM_SAMPLES normalized Dust readings and
 298           * returns the mean. Between samples LED_R blinks (half_ms on/off) for
 299           * `toggles` half-cycles, so the per-sample gap = toggles*half_ms and the
 300           * total window = FIRE_CONFIRM_SAMPLES * toggles * half_ms.
 301           *   pre-alarm    : (100 ms, 10) -> 0.2 s blink, 1 s/sample, 4 s total
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 6   

 302           *   fire re-check: (250 ms,  2) -> 0.5 s blink, 0.5 s/sample, 2 s total
 303           * Timer2 is left off here so its ISR cannot perturb the dust ADC sampling. */
 304          static uint16_t fire_confirm_avg(uint16_t half_ms, uint8_t toggles)
 305          {
 306   1        uint32_t sum = 0;
 307   1        uint8_t  i, t;
 308   1        for (i = 0; i < FIRE_CONFIRM_SAMPLES; i++) {
 309   2          ADC2_Dust_Val      = Dust_ADC_2AMP();
 310   2          ADC2_Dust_Val_Norm = calib_apply(ADC2_Dust_Val);
 311   2          sum += ADC2_Dust_Val_Norm;
 312   2          for (t = 0; t < toggles; t++) {
 313   3            if (t & 0x01) { LED_R_OFF; } else { LED_R_ON; }
 314   3            WD_Reset();
 315   3            Delay_ms(half_ms);
 316   3          }
 317   2        }
 318   1        LED_R_OFF;
 319   1        return (uint16_t)(sum / FIRE_CONFIRM_SAMPLES);
 320   1      }
 321          
 322          /* Fire LED_R blink via Timer2 ISR (0.2 s period, 0.1 s on/off). Lets LED_R
 323           * keep blinking even while a blocking Play_Clip() runs: audio plays on the
 324           * Timer1 ISR, so global interrupts are enabled during playback and Timer2
 325           * fires too. */
 326          static void fire_led_blink_start(void)
 327          {
 328   1        T2_init();
 329   1        Fire_Alarm_LED = 1;
 330   1        Timer2_Start();
 331   1      }
 332          static void fire_led_blink_stop(void)
 333          {
 334   1        Timer2_Stop();
 335   1        Fire_Alarm_LED = 0;
 336   1        LED_R_OFF;
 337   1      }
 338          static void lowbat_led_blink_start(void)
 339          {
 340   1        T2_init();
 341   1        Bat_Alarm_LED = 1;
 342   1        Timer2_Start();
 343   1      }
 344          static void lowbat_led_blink_stop(void)
 345          {
 346   1        Timer2_Stop();
 347   1        Bat_Alarm_LED = 0;
 348   1        LED_G_OFF;
 349   1      }
 350          
 351          /* Play the fire-alarm clip FIRE_VOICE_REPEAT times, FIRE_VOICE_GAP_MS (0.3 s)
 352           * apart. When with_led is set, LED_R blinks at 0.2 s (Timer2) for the whole
 353           * burst; otherwise LED_R is kept off (STEP 4 external-interlock case). */
 354          static uint8_t play_fire_burst(uint8_t with_led)
 355          {
 356   1        uint8_t i, j;
 357   1        uint8_t aborted = 0;
 358   1        if (with_led) { fire_led_blink_start(); }
 359   1      
 360   1        /* Pre-warm the audio amp / CVDD rail before the first clip. Audio_Run
 361   1         * power-gates CVDD/AUDIO per clip, so from a cold start (first alarm
 362   1         * after a long idle) the rail has not settled within Audio_Run's own
 363   1         * 0.3 s delay and the first clip is often inaudible. Powering the rail
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 7   

 364   1         * here and letting it settle removes that cold-start penalty; clips 2/3
 365   1         * already start from a warm rail. Tune FIRE_AMP_WARMUP_MS on hardware. */
 366   1        CVDD_ON;
 367   1        AUDIO_ON;
 368   1        loop_wait_ms(FIRE_AMP_WARMUP_MS);
 369   1      
 370   1        for (i = 0; i < FIRE_VOICE_REPEAT; i++) {
 371   2          Play_Clip(AUDIO_CLIP_FIRE);   /* ~3 s, self-kicks WDT */
 372   2          if (with_led) {
 373   3            /* poll SW2 across the 0.3 s inter-clip gap so a press is caught
 374   3             * mid-burst; on press abort the remaining clips (caller plays BOOT) */
 375   3            for (j = 0; j < (uint8_t)(FIRE_VOICE_GAP_MS / 20u); j++) {
 376   4              if (Port_GetInputpinValue(PORT1, PIN2) == 0) { aborted = 1; break; }
 377   4              WD_Reset();
 378   4              Delay_ms(20);
 379   4            }
 380   3            if (aborted) { break; }
 381   3          } else {
 382   3            loop_wait_ms(FIRE_VOICE_GAP_MS);
 383   3          }
 384   2        }
 385   1        if (with_led) { fire_led_blink_stop(); }
 386   1        else          { LED_R_OFF;            }
 387   1        return aborted;
 388   1      }
