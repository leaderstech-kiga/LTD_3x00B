1125          void BeforeStop(void)
1126          {
1127   1        /* Defensive OPAMP disable before sleep.
1128   1         * Root cause was AMP_AUTO_DIS=0 in main.h + missing DELAY_TIME macro
1129   1         * which selected the OPAMP-enable branch in hw_initial. Both are now
1130   1         * fixed, but keep this write as a safety net in case future code
1131   1         * enables OPAMP and forgets to clear it before sleep. */
1132   1        AMPCR1 = 0x00;
1133   1        LDOCR  = 0x00;     /* defensive: LDO OFF in case ADC code forgot LDO_OFF */
1134   1      
1135   1        /* Defensive: drop audio amp / flash VCC / LEDs in case anything was
1136   1         * left on by the previous active-code path. */
1137   1        AUDIO_OFF;
1138   1        CVDD_OFF;
1139   1        LED_G_OFF;
1140   1        LED_R_OFF;
1141   1      
1142   1        OSCCR = 0x84;       /* LFIRC enable + HIRC disable */
1143   1        WDTCR = 0xA2;       /* WDT enable, INTERRUPT mode, LFIRC clock */
1144   1        WDTDR = 2;          /* ~0.192 s wake period */
1145   1        IE3 |= 0x08;        /* WDT interrupt enable */
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 20  

1146   1      }
