1646   1        
1647   1        LDO_OFF;
1648   1      
1649   1        Temp_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1650   1        
1651   1        for(i=TEMP_OFFSET;i<(TEMP_OFFSET + 100);i++){
1652   2          if(Temp_Table[i] > Temp_adc_data){
1653   3            break;
1654   3          }
1655   2        }
1656   1        
