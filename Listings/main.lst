1617          /**********************************************************************
1618           * @brief       Get_Bat_Voltage_cV - measure battery voltage in units of
1619           *              0.01 V (e.g. return value 304 == 3.04 V).
1620           *              Reads the internal VBGR reference against VDD as ADC ref
1621           *              (ratiometric trick): VBGR_CV is the calibrated bandgap *100,
1622           *              ADC_FS = 1024 (10-bit FS), and the formula
1623           *                  Vbat_cv = (VBGR_CV * ADC_FS) / adc_reading
1624           *              gives Vbat in centivolts.
1625           **********************************************************************/
1626          uint16_t Get_Bat_Voltage_cV(void)   // unit: 0.01 V
1627          {
1628   1          uint32_t adc_avg;
1629   1          uint32_t vbat_cv;
1630   1      
1631   1      
1632   1          ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF reads VBGR against 
             -VDD - ratiometric Vbat math
1633   1          ADC_SelectChannel(ADC_VBGR);
1634   1          Delay_ms(1);
1635   1      
1636   1          ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 28  

1637   1      
1638   1          adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1639   1      
1640   1          if (adc_avg == 0) {
1641   2              ADCCRL = 0x00;            /* cleanup before early return */
1642   2              return 0;
1643   2          }
1644   1      
1645   1          vbat_cv = ((uint32_t)VBGR_CV * ADC_FS) / adc_avg;
1646   1      
1647   1          // sanity clamp (optional)
1648   1          if (vbat_cv > 400) vbat_cv = 400;   // ignore impossible >4.00 V readings
1649   1      
1650   1          /* Cleanup: disable ADC module. (P0FSRL untouched - this function does
1651   1           * not change pin functions.) */
1652   1          ADCCRL = 0x00;
1653   1      
1654   1          return (uint16_t)vbat_cv;
1655   1      }
