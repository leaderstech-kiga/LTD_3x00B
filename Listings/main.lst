C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 8   

 427          void main(void)
 428          {
 429   1      
 430   1        //LDO_OFF;
 431   1        //CVDD_OFF;
 432   1        //AUDIO_OFF;
 433   1        system_count = 0;
 434   1      //  uart_debug_mode = uart_debug_On;
 435   1        uart_debug_mode = uart_debug_Off;
 436   1      
 437   1        hw_initial_Wait(10);
 438   1      
 439   1       SystemStatus = SPI_Memory_Check();
 440   1      
 441   1        ADC_mode = Check_System();
 442   1      
 443   1        hw_initial_Wait(10);
 444   1        system_count = 0;
 445   1      
 446   1        SYS_mode =  Normal_mode;
 447   1      
 448   1        /* Boot / calibration initialisation (matches the existing product family).
 449   1         *
 450   1         *   STEP 1 - Power-on indication.
 451   1         *     calib_step1_boot_led(): LED_G + LED_R on together for 0.2 s.
 452   1         *
 453   1         *   STEP 2-1 - Flash erase + baseline capture (SW2 held at power-up).
 454   1         *     calib_erase_with_animation(): alternate G/R while held; on
 455   1         *     release erase the page, capture one clean-air baseline, save
 456   1         *     {baseline, gain=256} and set g_calib_needs_smoke = 1.
 457   1         *
 458   1         *   STEP 2-2 - Load (SW2 not held at power-up).
 459   1         *     calib_boot_init(): load baseline / gain_Q8 from DataFlash.
 460   1         *
 461   1         *   STEP 3 - Smoke gain calibration.
 462   1         *     Lives in the main loop (see the SW2 hold handler below):
 463   1         *     LED_R + release wait + place phase + 5-sample mean + gain save.
 464   1         */
 465   1      
 466   1        Port_SetInputpin(PORT1, PIN2, 1);
 467   1      
 468   1        /* STEP 1: power-on indication. */
 469   1        calib_step1_boot_led();
 470   1        
 471   1        if(uart_debug_mode == uart_debug_On){
 472   2          Uart_Out_Text( Boot_OK,11);
 473   2        }
 474   1      
 475   1      
 476   1        Delay_ms(300);
 477   1        if (Port_GetInputpinValue(PORT1, PIN2) == 0) {
 478   2          /* STEP 2-1: SW2 held -> erase + capture baseline + save. */
 479   2          calib_erase_with_animation();
 480   2        } else {
 481   2          /* STEP 2-2: SW2 not held -> load saved calibration. */
 482   2          calib_boot_init();
 483   2        }
 484   1        
 485   1        /* STEP 2 once before entering the loop (power LED + battery check). */
 486   1        Bat_mode = Bat_High_mode;
 487   1        LED_R_ON;
 488   1        Delay_ms(200);
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 9   

 489   1        LED_R_OFF;
 490   1        battery_check();
 491   1        system_count = 1;   /* avoid count==0 immediately re-triggering STEP1/2 */
 492   1      
 493   1        hw_initial_Wait(10);
 494   1      
 495   1        while(1)
 496   1        {
 497   2      
 498   2          // Arm RESET-mode WDT (~2 s timeout) at the top of every loop
 499   2          // iteration for active-code hang protection. BeforeStop() swaps
 500   2          // it back to INTERRUPT mode before Stop() so the wake timer
 501   2          // still works.
 502   2          WD_Reset();
 503   2      
 504   2        // =====================================================================
 505   2        // Main-loop procedure (STEP 1..5) - see docs/main_loop_design.md
 506   2        // Base wake/sleep behaviour: docs/wdt_periodic_v3.md
 507   2        // =====================================================================
 508   2      
 509   2          
 510   2        // STEP 1 - Fire monitoring (every FIRE_CHECK_CNT wakes, ~8.06 s)
 511   2        //////////////////////////////////////////////////////////////////////////////////////////
 512   2          if (system_count % FIRE_CHECK_CNT == 0) {
 513   3            fire_monitor_step();
 514   3          }
 515   2      
 516   2        // STEP 2 - Power LED + battery check (every LED_BAT_CNT wakes, ~56 s)
 517   2        //////////////////////////////////////////////////////////////////////////////////////////
 518   2          if (system_count % LED_BAT_CNT == 0) {
 519   3            LED_R_ON;
 520   3            Delay_ms(200);
 521   3            LED_R_OFF;
 522   3            battery_check();
 523   3          }
 524   2      
 525   2        // STEP 3 - Low-battery alarm repeat (every LOWBAT_ALARM_CNT wakes, ~280 s)
 526   2        //////////////////////////////////////////////////////////////////////////////////////////
 527   2          if (Bat_mode == Bat_Low_mode && (system_count % LOWBAT_ALARM_CNT == 0)) {
 528   3            Play_Clip(AUDIO_CLIP_LOWBAT);
 529   3          }
 530   2      
 531   2        // STEP 4 - External interlock fire alarm (every wake)
 532   2        //////////////////////////////////////////////////////////////////////////////////////////
 533   2          Port_SetInputpin(PORT1, PIN0, 0);
 534   2          if (Port_GetInputpinValue(PORT1, PIN0) == 1) {
 535   3            LED_R_OFF;
 536   3            play_fire_burst(0);          /* external interlock: LED_R stays off */
 537   3            loop_wait_ms(2000);
 538   3          }
 539   2      
 540   2        // STEP 5 - Status check : SW2 held in Normal mode (every wake)
 541   2        //////////////////////////////////////////////////////////////////////////////////////////
 542   2          if (SYS_mode == Normal_mode &&
 543   2              Port_GetInputpinValue(PORT1, PIN2) == 0) {
 544   3      
 545   3            if (g_calib_needs_smoke == 1) {
 546   4              calib_run_smoke();
 547   4              /* Production: the 12% smoke used for gain calibration is
 548   4               * still present, so run one fire-monitoring pass right away
 549   4               * to validate the alarm (voice + EMR_IO + LED) within the
 550   4               * same smoke injection. Only after a successful save - on a
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 10  

 551   4               * reject g_calib_needs_smoke stays 1 and there is too little
 552   4               * smoke to confirm anyway. The alarm self-clears once the
 553   4               * smoke is removed. */
 554   4              if (g_calib_needs_smoke == 0) {
 555   5                
 556   5                  if(uart_debug_mode == uart_debug_On){
 557   6                    Uart_Out_Text( Cal_OK,10);
 558   6                    Uart_Out();
 559   6                  }
 560   5                  
 561   5                fire_monitor_step();
 562   5              }
 563   4            } else {
 564   4              /* Calibrated: manual fire test - LED_R blinks at 0.5 s
 565   4               * (Timer2) during the voice playback. */
 566   4              Port_SetOutputpin(PORT1, PIN0, 0);
 567   4              P10 = 1;
 568   4              fire_led_blink_start();
 569   4              Play_Clip(AUDIO_CLIP_FIRE);   /* 1x */
 570   4              fire_led_blink_stop();
 571   4              P10 = 0;
 572   4              Port_SetInputpin(PORT1, PIN0, 0);
 573   4            }
 574   3          }
 575   2      
 576   2      
 577   2        system_count++;
 578   2      
 579   2          // Sleep cycle: BeforeStop arms WDT as INTERRUPT-mode wake timer
 580   2          // (WDTDR=2, ~0.192 s) for button-polling resolution.
 581   2          // After wake, the top-of-loop WD_Reset() switches WDT back to
 582   2          // RESET mode for the next iteration's hang protection.
 583   2        BeforeStop();
 584   2        GLOBAL_INTERRUPT_EN();
 585   2        Stop();
 586   2        AfterStop();
 587   2      
 588   2        }
 589   1      }
