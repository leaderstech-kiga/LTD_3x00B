1116          void BeforeStop(void)
1117          {
1118   1        /* Defensive OPAMP disable before sleep.
1119   1         * Root cause was AMP_AUTO_DIS=0 in main.h + missing DELAY_TIME macro
1120   1         * which selected the OPAMP-enable branch in hw_initial. Both are now
1121   1         * fixed, but keep this write as a safety net in case future code
1122   1         * enables OPAMP and forgets to clear it before sleep. */
1123   1        AMPCR1 = 0x00;
1124   1        LDOCR  = 0x00;     /* defensive: LDO OFF in case ADC code forgot LDO_OFF */
1125   1      
1126   1        /* Defensive: drop audio amp / flash VCC / LEDs in case anything was
1127   1         * left on by the previous active-code path. */
1128   1        AUDIO_OFF;
1129   1        CVDD_OFF;
1130   1        LED_G_OFF;
1131   1        LED_R_OFF;
1132   1      
1133   1        OSCCR = 0x84;       /* LFIRC enable + HIRC disable */
1134   1        WDTCR = 0xA2;       /* WDT enable, INTERRUPT mode, LFIRC clock */
1135   1        WDTDR = 2;          /* ~0.192 s wake period */
1136   1        IE3 |= 0x08;        /* WDT interrupt enable */
1137   1      }
1138          //----------------------------------------------------------------------------
1139          void AfterStop(void)
1140          {
1141   1      
1142   1        IE3 &= ~(0x08);                     // WDT interrupt disable
1143   1        //WDTCR = 0x00;
1144   1        
1145   1        /*
1146   1      #ifdef SysClock_1MHZ  
1147   1        OSCCR = 0x08;                                            // System clock: 1MHz
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 20  

1148   1      #else 
1149   1        OSCCR = 0x18;                                            // System clock: 4MHz
1150   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1151   1      #endif
1152   1        */
1153   1        OSCCR = 0x18;                                            // System clock: 4MHz
1154   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1155   1      }
