1200          /**********************************************************************
1201           * @brief   Audio_Run
1202           * @param     None
1203           * @return  None
1204           **********************************************************************/
1205          void Audio_Run(uint16_t Address , uint16_t Length,  uint8_t Run_time){
1206   1           
1207   1        CVDD_ON;
1208   1        AUDIO_ON; 
1209   1        
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 21  

1210   1        Audio_start = 1;
1211   1      
1212   1        P2 = 0x01;
1213   1        /* SPI Initial */
1214   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
1215   1        
1216   1        NOP_20us_Delay(5000);         // 0.1sec
1217   1        NOP_20us_Delay(5000);         // 0.1sec
1218   1        NOP_20us_Delay(5000);         // 0.1sec
1219   1        
1220   1        Audio_max_length = Length;
1221   1        Variable_Initial(Address);
1222   1        
1223   1          /* Audio Initial */
1224   1        Audio_Initial();  
1225   1        
1226   1        NOP_20us_Delay(1000);         // 0.02sec
1227   1        NOP_20us_Delay(1000);         // 0.02sec
1228   1        NOP_20us_Delay(1000);         // 0.02sec
1229   1        
1230   1        
1231   1        Timer1_Start();
1232   1      
1233   1        // Audio clips run ~3 seconds (Audio3_length=24324 samples @ 8 kHz =
1234   1        // 3.04 s) which exceeds the 2-s active-mode WDT timeout. Refresh the
1235   1        // watchdog inside this polling loop so playback is not aborted by a
1236   1        // false WDT reset. The CPU is otherwise idle here while the
1237   1        // TIMER1_Int ISR feeds samples in the background.
1238   1        //
1239   1        // Stall detector.
1240   1        //
1241   1        // The WD_Reset() inside this loop also means the active-mode WDT will
1242   1        // NEVER fire here, even if the audio ISR stops making progress
1243   1        // (Audio_length not incrementing because of e.g. SPI fault, SPI clock
1244   1        // glitch, TIMER1_Int disabled). The loop would then spin forever and
1245   1        // the device would appear hung from the outside.
1246   1        //
1247   1        // We track Audio_length progress and bail out if it does not advance
1248   1        // for ~200 ms. At ~125 us per audio sample the ISR should increment
1249   1        // Audio_length about 1600 times during 200 ms, so 200 ms of zero
1250   1        // progress is unambiguous evidence of a stall.
1251   1        {
1252   2          uint16_t prev_length  = 0xFFFF;   /* sentinel - guaranteed != on first iter */
1253   2          uint16_t stall_count  = 0;
1254   2      
1255   2          while (Audio_length < Audio_max_length) {
1256   3            WD_Reset();                   /* kick dog during long playback */
1257   3      
1258   3            if (Audio_length == prev_length) {
1259   4              /* No progress this iteration. ~4 us per while iter at 4 MHz,
1260   4               * so 50000 iterations ~= 200 ms of no progress = stall. */
1261   4              if (++stall_count > 50000) {
1262   5                break;
1263   5              }
1264   4            } else {
1265   4              prev_length = Audio_length;
1266   4              stall_count = 0;
1267   4            }
1268   3          }
1269   2        }
1270   1      
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 22  

1271   1        /* Deterministic teardown. Previously only Timer0 was stopped (inside the
1272   1         * TIMER1_Int done-branch), and Timer1 was left running. Because Audio_run
1273   1         * sets Audio_start = 0 below, leftover Timer1 ticks kept re-entering the
1274   1         * ISR prime branch every 125 us (re-asserting Read/Timer0) until the next
1275   1         * clip - harmless only because CVDD is off, but wasteful and fragile, and
1276   1         * the stall-break path left the flash CS asserted. Stop everything here so
1277   1         * teardown does not depend on a post-loop interrupt firing. */
1278   1        Timer1_Stop();     /* stop the 8 kHz sample interrupt */
1279   1        Timer0_Stop();     /* stop PWM output                 */
1280   1        SLAVEDESELECT;     /* release the audio-flash CS      */
1281   1      
1282   1        CVDD_OFF;
1283   1        AUDIO_OFF;
1284   1      
1285   1        //Port_SetOutputpin(PORT1, PIN0, 0);
1286   1        //P10 = 1;
1287   1      
1288   1        Audio_start = 0;
1289   1      }
