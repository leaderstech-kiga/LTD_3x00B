 939          uint8_t SPI_Memory_Check(void){
 940   1        
 941   1        uint8_t SystemStatus_Read;
 942   1        uint8_t deviceID[3];
 943   1        
 944   1          // SPI Memory Check
 945   1        // CVDD_ON drives P20 = 1, which is the C_VDD signal supplying VCC to
 946   1        // U3 (MX25L1006E). P20 is a regular GPIO output (~50 ohm), so the
 947   1        // flash supply rail (C14 decoupling) charges through that impedance.
 948   1        CVDD_ON;             // P20 = 1 -> C_VDD high -> flash VCC ON
 949   1      
 950   1        // Wait for flash VCC to settle after C_VDD goes high (10 uF cap
 951   1        // on the rail charges through the P20 GPIO output impedance).
 952   1        NOP_20us_Delay(500);  // ~10 ms settle time for 10 uF flash VCC
 953   1      
 954   1        // SPI Initial
 955   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
 956   1      
 957   1        Get_Identification(deviceID);
 958   1      
 959   1        // Match expected MX25L1006E JEDEC ID + verify no SPI timeout
 960   1        // (so a 0xFF-on-each-byte timeout doesn't look like a partial match).
 961   1        if( (deviceID[0]==0xC2)&&(deviceID[1]==0x20)&&(deviceID[2]==0x11) && (SPI_Timeout == 0) )
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 17  

 962   1        {
 963   2          SystemStatus_Read=1;
 964   2        }
 965   1        else{
 966   2          SystemStatus_Read=0;
 967   2        }
 968   1      
 969   1        CVDD_OFF;
 970   1        
 971   1          if(SystemStatus_Read == 1){
 972   2          
 973   2          LED_G_ON;
 974   2          Delay_ms(50);
 975   2          LED_G_OFF;
 976   2          
 977   2        }
 978   1        else{
 979   2          
 980   2          LED_R_ON;
 981   2          Delay_ms(50);
 982   2          LED_R_OFF;
 983   2        }
 984   1        
 985   1        
 986   1        Delay_ms(100);
 987   1        LED_G_ON;
 988   1        LED_R_ON;
 989   1        Delay_ms(50);
 990   1        LED_G_OFF;
 991   1        LED_R_OFF;
 992   1        
 993   1        return SystemStatus_Read;
 994   1      }
