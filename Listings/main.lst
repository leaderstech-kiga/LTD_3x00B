1502          /**********************************************************************
1503           * @brief       Check_System - autodetect heat-vs-smoke variant.
1504           *              Probes AN3 with LDO on vs LDO off. A heat (NTC) variant
1505           *              shows a large delta; a smoke (photoelectric) variant does
1506           *              not. Returns Temp_mode or Dust_mode accordingly.
1507           **********************************************************************/
1508          uint16_t Check_System(void)
1509          {
1510   1        int V25_On_adc_data= 0 , V25_Off_adc_data= 0;
1511   1        uint16_t System_Mode_Ck;
1512   1      
1513   1        // OPAMP outputs disabled; route AN3/AN2/AN1 to ADC pins.
1514   1        P0FSRL  = 0
1515   1          | ( 2 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used          // SENSING IN ADC
1516   1          | ( 2 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used              // Temperature_ADC
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 26  

1517   1          | ( 2<< 2)        //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used        //
1518   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used      // C_VDD
1519   1      
1520   1        OP0_Enable(FALSE);
1521   1        OP1_Enable(FALSE);
1522   1        LDO_ON;
1523   1        ADC_Initial(ADC_CLK_1M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF + LDO_ON sequence isola
             -tes heat-variant signal
1524   1        ADC_SelectChannel(ADC_CH3);
1525   1        
1526   1        Delay_ms(1);
1527   1        
1528   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1529   1        
1530   1        LDO_OFF;
1531   1      
1532   1        V25_On_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1533   1        
1534   1        Delay_ms(20);
1535   1        
1536   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1537   1        V25_Off_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1538   1      
1539   1        if( abs(V25_On_adc_data - V25_Off_adc_data) > System_Ck_Value){
1540   2          System_Mode_Ck = Temp_mode;
1541   2        }
1542   1        else{
1543   2          System_Mode_Ck = Dust_mode;
1544   2        }
1545   1      
1546   1        /* Cleanup: disable ADC + restore P0FSRL to hw_initial baseline so the
1547   1         * caller does not inherit an active ADC block or AN3/AN2/AN1 pin mode. */
1548   1        ADCCRL = 0x00;
1549   1        P0FSRL = 0
1550   1          | (1 << 6)        /* P03 = OP0OUT (hw_initial baseline) */
1551   1          | (1 << 4)        /* P02 = OP1P                          */
1552   1          | (1 << 2)        /* P01 = OP1N                          */
1553   1          | (0 << 0);       /* P00 = I/O                           */
1554   1      
1555   1        return System_Mode_Ck;
1556   1      }
