1431          /**********************************************************************
1432           * @brief       Data_Avr - simple arithmetic mean over `count` ADC samples
1433           * @param       adc_data - pointer to array of uint16_t samples
1434           * @param       count    - number of elements (NOT bytes!)
1435           * @return      average value, or 0 if count==0
1436           **********************************************************************/
1437          uint16_t Data_Avr(uint16_t *adc_data, uint8_t count){
1438   1        
1439   1        uint32_t temp = 0;
1440   1        uint8_t i;
1441   1        
1442   1        if(count < 1){
1443   2          return 0;
1444   2        }
1445   1        
1446   1        for(i=0; i<count ; i++){
1447   2          temp = temp + adc_data[i];
1448   2        }
1449   1        
1450   1        temp = temp / count;
1451   1        
1452   1        return temp;
1453   1        
1454   1      }
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 25  

1455          
1456          void Data_Sorting(uint16_t *adc_data, uint8_t count)
1457          {
1458   1        uint8_t i,j;
1459   1        uint16_t temp;
1460   1      
1461   1        if(count < 1){
1462   2          return;
1463   2        }
1464   1        
1465   1        for(i = 0; i < (count-1); i++)
1466   1        {
1467   2          for(j = i+1; j < count; j++)
1468   2          {
1469   3            
1470   3            if(adc_data[i] > adc_data[j])
1471   3            {
1472   4              temp = adc_data[i];
1473   4              adc_data[i]=adc_data[j];
1474   4              adc_data[j]=temp;
1475   4            }
1476   3          }
1477   2        }
1478   1      }
1479          
1480          uint16_t Data_TrimmedMean(uint16_t *adc_data, uint8_t count){
1481   1      
1482   1        uint32_t temp = 0;
1483   1        uint8_t i;
1484   1        
1485   1        if(count < 3){
1486   2          return 0;
1487   2        }
1488   1        
1489   1        
1490   1        Data_Sorting(adc_data, count);
1491   1        
1492   1        for(i=1; i<(count -1) ; i++){
1493   2          temp = temp + adc_data[i];
1494   2        }
1495   1        
1496   1        temp = temp / (count -2);
1497   1        
1498   1        return temp;
1499   1        
1500   1      }
