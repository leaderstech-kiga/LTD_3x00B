1463          
1464          void Uart_Out_Int(uint16_t Value){
1465   1      
1466   1        uint16_t int_val;
1467   1        uint8_t tmp;
1468   1        
1469   1        if(Value > 9999){
1470   2          Value = 9999;
1471   2        }
1472   1        
1473   1        tmp = Value / 1000 + 48;
1474   1        USART_SendDataWithPolling(&tmp, 1);
1475   1        int_val= Value % 1000 ;
1476   1        tmp = (int_val/ 100 )+ 48;
1477   1        USART_SendDataWithPolling(&tmp, 1);
1478   1        int_val= Value % 100 ;
1479   1        tmp = (int_val/ 10 )+ 48;
1480   1        USART_SendDataWithPolling(&tmp, 1);
1481   1        int_val= Value % 10 ;
1482   1        tmp = (int_val/ 1) + 48;
1483   1        USART_SendDataWithPolling(&tmp, 1);
1484   1      }
