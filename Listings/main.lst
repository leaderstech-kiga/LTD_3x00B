1157          /**********************************************************************
1158           * @brief   WD_Reset - configure WDT in RESET mode for hang protection.
1159           *
1160           *   Purpose: while the MCU is awake and executing code, the WDT must be
1161           *   armed in RESET mode so that any hang (stuck SPI poll, infinite loop,
1162           *   ISR deadlock, EMI-induced PC corruption, etc.) triggers an automatic
1163           *   MCU reset rather than leaving the device silently dead. Safety-
1164           *   critical for a fire detector.
1165           *
1166           *   The complementary wake-from-Stop timer (BeforeStop) keeps WDT in
1167           *   INTERRUPT mode with WDTDR=2 (~0.192 s). On every wake we call this
1168           *   function to switch WDT into RESET mode with the longer timeout;
1169           *   BeforeStop will switch it back before the next Stop.
1170           *
1171           *   Behaviour:
1172           *     - Clock source : WDTRC (~3.072 MHz internal, independent of MCLK)
1173           *     - Timeout      : WDTDR = 30  ->  approximately 2 seconds.
1174           *                      Long enough to cover normal active code paths
1175           *                      (Dust_ADC_Single, Delay_ms(100), hw_initial_Wait,
1176           *                      etc.); shorter than the time a real hang would
1177           *                      take to be noticeable. Longer blocking calls
1178           *                      (Audio_Run audio playback, Fire_Alarm loop) must
1179           *                      refresh the counter by calling WD_Reset()
1180           *                      themselves - see those functions below.
1181           *     - Mode         : RESET (WDTCR bit 6 set) -> MCU reset on overflow.
1182           *
1183           *   Note: WDTCR also has bit 5 (WDTCL) set, which clears the counter on
1184           *   every write, so each WD_Reset() call effectively "kicks the dog".
1185           **********************************************************************/
1186          void WD_Reset(void)
1187          {
1188   1        WDTDR = 30;                       // ~2 sec active-mode timeout
1189   1        //WDTCR = 0xA3;                     // set WDT enable , clock source LFIRC, WDT interrupt
1190   1        //WDTCR = 0xE5;                     // WDT enable, RESET mode (bit6=1), WDTRC clock, clear counter
1191   1        WDTCR = 0xE3;     /* 11100011: WDTEN=1, RESET mode, WDTCL=1, WDTCK=01 (LFIRC) */
1192   1        IE3 |= 0x08;                      // WDT interrupt enable (no effect in reset mode but harmless)
1193   1      }
1194          
1195          void WDT_Int(void) interrupt WDT_VECT
1196          {
1197   1        WDTCR &= ~0x01;
1198   1      }
