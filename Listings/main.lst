1536          /**********************************************************************
1537           * @brief       Check_System - autodetect heat-vs-smoke variant.
1538           *              Probes AN3 with LDO on vs LDO off. A heat (NTC) variant
1539           *              shows a large delta; a smoke (photoelectric) variant does
1540           *              not. Returns Temp_mode or Dust_mode accordingly.
1541           **********************************************************************/
1542          uint16_t Check_System(void)
1543          {
1544   1        int V25_On_adc_data= 0 , V25_Off_adc_data= 0;
1545   1        uint16_t System_Mode_Ck;
1546   1      
1547   1        // OPAMP outputs disabled; route AN3/AN2/AN1 to ADC pins.
1548   1        P0FSRL  = 0
1549   1          | ( 2 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used          // SENSING IN ADC
1550   1          | ( 2 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used              // Temperature_ADC
1551   1          | ( 2<< 2)        //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used        //
1552   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used      // C_VDD
1553   1      
1554   1        OP0_Enable(FALSE);
1555   1        OP1_Enable(FALSE);
1556   1        LDO_ON;
1557   1        ADC_Initial(ADC_CLK_1M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF + LDO_ON sequence isola
             -tes heat-variant signal
1558   1        ADC_SelectChannel(ADC_CH3);
1559   1        
1560   1        Delay_ms(1);
1561   1        
1562   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1563   1        
1564   1        LDO_OFF;
1565   1      
1566   1        V25_On_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1567   1        
1568   1        Delay_ms(20);
1569   1        
1570   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1571   1        V25_Off_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1572   1      
1573   1        if( abs(V25_On_adc_data - V25_Off_adc_data) > System_Ck_Value){
1574   2          System_Mode_Ck = Temp_mode;
1575   2        }
1576   1        else{
1577   2          System_Mode_Ck = Dust_mode;
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 27  

1578   2        }
1579   1      
1580   1        /* Cleanup: disable ADC + restore P0FSRL to hw_initial baseline so the
1581   1         * caller does not inherit an active ADC block or AN3/AN2/AN1 pin mode. */
1582   1        ADCCRL = 0x00;
1583   1        P0FSRL = 0
1584   1          | (1 << 6)        /* P03 = OP0OUT (hw_initial baseline) */
1585   1          | (1 << 4)        /* P02 = OP1P                          */
1586   1          | (1 << 2)        /* P01 = OP1N                          */
1587   1          | (0 << 0);       /* P00 = I/O                           */
1588   1      
1589   1        return System_Mode_Ck;
1590   1      }
1591          
