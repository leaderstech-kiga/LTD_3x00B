 264          /*----------------------------------------------------------------------------*
 265           * Main-loop procedure constants + helpers (see docs/main_loop_design.md).    *
 266           *   Wake tick = 0.192 s (WDT INTERRUPT mode); periodic tasks use system_count *
 267           *   modulo. EMR_IO = P10 (PORT1/PIN0): driven high when THIS unit alarms,     *
 268           *   read as input for the external interlock line.                           *
 269           *----------------------------------------------------------------------------*/
 270          #define FIRE_CHECK_CNT        42u    /* STEP1 fire monitor   : 42  wakes ~8.06 s   */
 271          #define LED_BAT_CNT           292u   /* STEP2 LED + battery  : 292 wakes ~56.06 s  */
 272          #define LOWBAT_ALARM_CNT      1458u  /* STEP3 low-bat repeat : 1458 wakes ~279.9 s */
 273          #define FIRE_CONFIRM_SAMPLES  4u     /* STEP1 averaged confirm readings            */
 274          #define FIRE_BLINK_MS         100u   /* pre-alarm blink half-period (0.1 s -> 0.2 s)*/
 275          #define FIRE_GAP_TOGGLES      10u    /* pre-alarm blinks per gap (10*0.1=1 s, 4=4 s)*/
 276          #define FIRE_VOICE_REPEAT     3u     /* fire clip plays per alarm burst            */
 277          #define FIRE_VOICE_GAP_MS     300u   /* gap between fire-clip plays (0.3 s)        */
 278          #define FIRE_AMP_WARMUP_MS    150u   /* amp/CVDD pre-warm before 1st clip (cold)   */
 279          #define FIRE_RECHECK_HALF_MS  250u   /* fire-loop re-confirm blink half (0.25 s)   */
 280          #define FIRE_RECHECK_TOGGLES  2u     /* re-confirm toggles/sample (2*0.25=0.5 s, 4=2 s)*/
 281          #define BAT_LOW_CV            265u   /* enter low-battery at <= 2.65 V             */
 282          #define BAT_RECOVER_CV        275u   /* exit  low-battery at >= 2.75 V (hysteresis)*/
 283          
 284          /* WDT-safe blocking wait (RESET-mode WDT ~2 s) in 100 ms chunks. */
 285          static void loop_wait_ms(uint16_t ms)
 286          {
 287   1        while (ms >= 100) { WD_Reset(); Delay_ms(100); ms -= 100; }
 288   1        if (ms)          { WD_Reset(); Delay_ms(ms);              }
 289   1      }
 290          
 291          /* STEP1 helper: takes FIRE_CONFIRM_SAMPLES normalized Dust readings and
 292           * returns the mean. Between samples LED_R blinks (half_ms on/off) for
 293           * `toggles` half-cycles, so the per-sample gap = toggles*half_ms and the
 294           * total window = FIRE_CONFIRM_SAMPLES * toggles * half_ms.
 295           *   pre-alarm    : (100 ms, 10) -> 0.2 s blink, 1 s/sample, 4 s total
 296           *   fire re-check: (250 ms,  2) -> 0.5 s blink, 0.5 s/sample, 2 s total
 297           * Timer2 is left off here so its ISR cannot perturb the dust ADC sampling. */
 298          static uint16_t fire_confirm_avg(uint16_t half_ms, uint8_t toggles)
 299          {
 300   1        uint32_t sum = 0;
 301   1        uint8_t  i, t;
 302   1        for (i = 0; i < FIRE_CONFIRM_SAMPLES; i++) {
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 6   

 303   2          ADC2_Dust_Val      = Dust_ADC_2AMP();
 304   2          ADC2_Dust_Val_Norm = calib_apply(ADC2_Dust_Val);
 305   2          sum += ADC2_Dust_Val_Norm;
 306   2          for (t = 0; t < toggles; t++) {
 307   3            if (t & 0x01) { LED_R_OFF; } else { LED_R_ON; }
 308   3            WD_Reset();
 309   3            Delay_ms(half_ms);
 310   3          }
 311   2        }
 312   1        LED_R_OFF;
 313   1        return (uint16_t)(sum / FIRE_CONFIRM_SAMPLES);
 314   1      }
 315          
 316          /* Fire LED_R blink via Timer2 ISR (0.2 s period, 0.1 s on/off). Lets LED_R
 317           * keep blinking even while a blocking Play_Clip() runs: audio plays on the
 318           * Timer1 ISR, so global interrupts are enabled during playback and Timer2
 319           * fires too. */
 320          static void fire_led_blink_start(void)
 321          {
 322   1        T2_init();
 323   1        Fire_Alarm_LED = 1;
 324   1        Timer2_Start();
 325   1      }
 326          static void fire_led_blink_stop(void)
 327          {
 328   1        Timer2_Stop();
 329   1        Fire_Alarm_LED = 0;
 330   1        LED_R_OFF;
 331   1      }
 332          
 333          /* Play the fire-alarm clip FIRE_VOICE_REPEAT times, FIRE_VOICE_GAP_MS (0.3 s)
 334           * apart. When with_led is set, LED_R blinks at 0.2 s (Timer2) for the whole
 335           * burst; otherwise LED_R is kept off (STEP 4 external-interlock case). */
 336          static void play_fire_burst(uint8_t with_led)
 337          {
 338   1        uint8_t i;
 339   1        if (with_led) { fire_led_blink_start(); }
 340   1      
 341   1        /* Pre-warm the audio amp / CVDD rail before the first clip. Audio_Run
 342   1         * power-gates CVDD/AUDIO per clip, so from a cold start (first alarm
 343   1         * after a long idle) the rail has not settled within Audio_Run's own
 344   1         * 0.3 s delay and the first clip is often inaudible. Powering the rail
 345   1         * here and letting it settle removes that cold-start penalty; clips 2/3
 346   1         * already start from a warm rail. Tune FIRE_AMP_WARMUP_MS on hardware. */
 347   1        CVDD_ON;
 348   1        AUDIO_ON;
 349   1        loop_wait_ms(FIRE_AMP_WARMUP_MS);
 350   1      
 351   1        for (i = 0; i < FIRE_VOICE_REPEAT; i++) {
 352   2          Play_Clip(AUDIO_CLIP_FIRE);   /* ~3 s, self-kicks WDT */
 353   2          loop_wait_ms(FIRE_VOICE_GAP_MS);
 354   2        }
 355   1        if (with_led) { fire_led_blink_stop(); }
 356   1        else          { LED_R_OFF;            }
 357   1      }
 358          
 359          /* STEP2/3 helper: read battery, update Bat_mode with hysteresis, and fire
 360           * the immediate low-battery voice on the High->Low transition. */
 361          static void battery_check(void)
 362          {
 363   1        ADC_Bat_Val = Get_Bat_Voltage_cV();
 364   1        if (Bat_mode != Bat_Low_mode) {
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 7   

 365   2          if (ADC_Bat_Val <= BAT_LOW_CV) {
 366   3            Bat_mode = Bat_Low_mode;
 367   3            Play_Clip(AUDIO_CLIP_LOWBAT);   /* STEP3: immediate 1x on entry */
 368   3          }
 369   2        } else {
 370   2          if (ADC_Bat_Val >= BAT_RECOVER_CV) {
 371   3            Bat_mode = Bat_High_mode;
 372   3          }
 373   2        }
 374   1      }
 375          
 376          /* STEP1 helper: one fire-monitoring pass - sample dust, normalize, and on a
 377           * confirmed over-threshold reading drive the alarm (voice + EMR_IO + LED_R)
 378           * until the smoke clears. Called both from the periodic STEP1 schedule and,
 379           * on the production line, right after a successful smoke calibration so the
 380           * same 12% smoke injection doubles as a functional alarm test. */
 381          static void fire_monitor_step(void)
 382          {
 383   1        ADC2_Dust_Val      = Dust_ADC_2AMP();
 384   1        ADC2_Dust_Val_Norm = calib_apply(ADC2_Dust_Val);
 385   1      
 386   1        if (uart_debug_mode == uart_debug_On) {
 387   2          ADC_Bat_Val = Get_Bat_Voltage_cV();
 388   2          Uart_Out();
 389   2        }
 390   1      
 391   1        if (ADC2_Dust_Val_Norm >= CALIB_ALARM_THRESHOLD) {
 392   2          /* Pre-alarm: confirm with a 4-sample average (0.2 s blink, ~4 s). */
 393   2          uint16_t smoke_avg = fire_confirm_avg(FIRE_BLINK_MS, FIRE_GAP_TOGGLES);
 394   2      
 395   2          if (smoke_avg >= CALIB_ALARM_THRESHOLD) {
 396   3            /* Confirmed fire: drive EMR_IO high, alarm until cleared. */
 397   3            Port_SetOutputpin(PORT1, PIN0, 0);
 398   3            P10 = 1;
 399   3      
 400   3            do {
 401   4              /* voice: FIRE x3, 0.3 s apart, LED_R 0.2 s blink (Timer2) */
 402   4              play_fire_burst(1);
 403   4              /* re-check: 4 samples, 0.25 s blink, 0.5 s/sample, ~2 s */
 404   4              smoke_avg = fire_confirm_avg(FIRE_RECHECK_HALF_MS, FIRE_RECHECK_TOGGLES);
 405   4              if (uart_debug_mode == uart_debug_On) {
 406   5                Uart_Out_Fire(smoke_avg);
 407   5              }
 408   4            } while (smoke_avg >= CALIB_ALARM_THRESHOLD);
 409   3      
 410   3            /* Cleared: stop alarm, release the interlock line. */
 411   3            LED_R_OFF;
 412   3            P10 = 0;
 413   3            Port_SetInputpin(PORT1, PIN0, 0);
 414   3          }
 415   2        }
 416   1      }
