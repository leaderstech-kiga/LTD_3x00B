1559          /**********************************************************************
1560           * @brief       TEMP_ADC - read NTC thermistor through AN3 with LDO23 on
1561           *              as reference. Looks up the result in Temp_Table[] and
1562           *              returns temperature in degrees C (clamped 0..100).
1563           **********************************************************************/
1564          uint16_t TEMP_ADC(void)
1565          {
1566   1        int Temp_adc_data= 0 , Temp_Data;
1567   1        int i;
1568   1      
1569   1        // Route AN3 (NTC divider) to ADC; OPAMPs disabled.
1570   1        P0FSRL  = 0
1571   1          | ( 2 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used          // SENSING IN ADC
1572   1          | ( 2 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used              // Temperature_AD
             -C
1573   1          | ( 2<< 2)        //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used        // BAT_ADC
1574   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used      // C_VDD
1575   1      
1576   1        OP0_Enable(FALSE);
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 27  

1577   1        OP1_Enable(FALSE);
1578   1        LDO_ON;
1579   1        ADC_Initial(ADC_CLK_1M, ADC_SW_TRIG, ADC_LDO_REF, ADC_LSB);  // LDO_REF: NTC ratiometric measurement immu
             -ne to LDO drift
1580   1        ADC_SelectChannel(ADC_CH3);
1581   1        
1582   1        Delay_ms(1);
1583   1        
1584   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1585   1        
1586   1        LDO_OFF;
1587   1      
1588   1        Temp_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1589   1        
1590   1        for(i=TEMP_OFFSET;i<(TEMP_OFFSET + 100);i++){
1591   2          if(Temp_Table[i] > Temp_adc_data){
1592   3            break;
1593   3          }
1594   2        }
1595   1        
1596   1        if(i == (TEMP_OFFSET + 100)){
1597   2          Temp_Data = 100;
1598   2        }
1599   1        else if (i==TEMP_OFFSET){
1600   2          Temp_Data = 0;
1601   2        }
1602   1        else{
1603   2          Temp_Data = i -TEMP_OFFSET - 1 ;
1604   2        }
1605   1      
1606   1        /* Cleanup: disable ADC + restore P0FSRL to hw_initial baseline. */
1607   1        ADCCRL = 0x00;
1608   1        P0FSRL = 0
1609   1          | (1 << 6)        /* P03 = OP0OUT (hw_initial baseline) */
1610   1          | (1 << 4)        /* P02 = OP1P                          */
1611   1          | (1 << 2)        /* P01 = OP1N                          */
1612   1          | (0 << 0);       /* P00 = I/O                           */
1613   1      
1614   1        return Temp_Data;
1615   1      }
