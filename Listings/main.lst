1152   1        //WDTCR = 0x00;
1153   1        
1154   1        /*
1155   1      #ifdef SysClock_1MHZ  
1156   1        OSCCR = 0x08;                                            // System clock: 1MHz
1157   1      #else 
1158   1        OSCCR = 0x18;                                            // System clock: 4MHz
1159   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1160   1      #endif
1161   1        */
1162   1        OSCCR = 0x18;                                            // System clock: 4MHz
1163   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1164   1      }
