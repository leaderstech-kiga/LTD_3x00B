1811          /**********************************************************************
1812           * @brief   Dust_ADC_2amp
1813           * @param     None
1814           * @return  None
1815           **********************************************************************/
1816          
1817          uint16_t Dust_ADC_2AMP(void)
1818          {
1819   1        uint16_t Dust_adc_data = 0;
1820   1        uint32_t adc_avg;
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 31  

1821   1        uint32_t op;
1822   1      
1823   1        /* Pin function map - same as 1AMP; OP-amp chain OP0 -> OP1 -> ADC */
1824   1        P0FSRL  = 0
1825   1          | ( 1 << 6)       /* P03 : OP0OUT (first stage out)             */
1826   1          | ( 1 << 4)       /* P02 : OP1P   (second stage non-inv input)  */
1827   1          | ( 2 << 2)       /* P01 : AN1    (battery ADC channel)         */
1828   1          | ( 1 << 0);      /* P00 : OP1OUT (final amp output, test pt)   */
1829   1      
1830   1        if (visual_type == 1) {
1831   2          OPAMP_Initial(GAIN1_X30, GAIN0_DIS, chp_125KHz);
1832   2        } else {
1833   2          OPAMP_Initial(GAIN1_X15, GAIN0_DIS, chp_125KHz);
1834   2        }
1835   1      
1836   1        /* Two-stage amp sequence: enable OP0 first, wait 200 us per User
1837   1         * Manual Figure 43 NOTE 2 ("turn on the first OP-AMP and provide a
1838   1         * delay of at least 200 us before turn on the second OP-AMP"), then
1839   1         * enable OP1. Without this delay the first sample is unreliable. */
1840   1        OP0_Enable(TRUE);
1841   1        NOP_20us_Delay(10);          /* ~200 us OP0 stabilization */
1842   1        OP1_Enable(TRUE);
1843   1      
1844   1        ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);
1845   1        ADC_SelectChannel(ADC_VBGR);
1846   1        Delay_ms(1);
1847   1      
1848   1        /* 1) VBGR measurement -> ratiometric battery compensation */
1849   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1850   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1851   1        if (adc_avg == 0) {
1852   2          goto cleanup;            /* divide-by-zero guard */
1853   2        }
1854   1        op  = 92;
1855   1        op *= 1024;
1856   1        op /= adc_avg;
1857   1        ADC2_Bat_Val = op;
1858   1      
1859   1        /* 2) LED ON - chamber sensing through 2-stage amp.
1860   1         * No divide-by-zero possible (multiplication only, /1024 is the only
1861   1         * division). adc_avg=0 is a legitimate dark-chamber reading. */
1862   1        LDO_ON;
1863   1        ADC_SelectChannel(ADC_OP1OUT);
1864   1        Delay_ms(1);
1865   1      
1866   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1867   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1868   1      
1869   1        LDO_OFF;
1870   1        Delay_ms(1);
1871   1      
1872   1        op  = ADC2_Bat_Val;
1873   1        op *= adc_avg;
1874   1        op /= 1024;
1875   1        ADC2_On_Dust_Val = op;
1876   1      
1877   1        /* 3) LED OFF - ambient reference (still on ADC_OP1OUT) */
1878   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1879   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1880   1      
1881   1        op  = ADC2_Bat_Val;
1882   1        op *= adc_avg;
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 32  

1883   1        op /= 1024;
1884   1        ADC2_Off_Dust_Val = op;
1885   1      
1886   1        /* Underflow guard - same rationale as Dust_ADC_1AMP */
1887   1        if (ADC2_On_Dust_Val > ADC2_Off_Dust_Val) {
1888   2          Dust_adc_data = ADC2_On_Dust_Val - ADC2_Off_Dust_Val;
1889   2        } else {
1890   2          Dust_adc_data = 0;
1891   2        }
1892   1      
1893   1      cleanup:
1894   1        ADCCRL = 0x00;
1895   1        OP0_Enable(FALSE);
1896   1        OP1_Enable(FALSE);
1897   1        AMPCR1 = 0x00;
1898   1        P0FSRL = 0
1899   1          | (1 << 6)        /* P03 = OP0OUT (baseline) */
1900   1          | (1 << 4)        /* P02 = OP1P              */
1901   1          | (1 << 2)        /* P01 = OP1N              */
1902   1          | (0 << 0);       /* P00 = I/O               */
1903   1      
1904   1        return Dust_adc_data;
