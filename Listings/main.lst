1678          /**********************************************************************
1679           * @brief       Get_Bat_Voltage_cV - measure battery voltage in units of
1680           *              0.01 V (e.g. return value 304 == 3.04 V).
1681           *              Reads the internal VBGR reference against VDD as ADC ref
1682           *              (ratiometric trick): VBGR_CV is the calibrated bandgap *100,
1683           *              ADC_FS = 1024 (10-bit FS), and the formula
1684           *                  Vbat_cv = (VBGR_CV * ADC_FS) / adc_reading
1685           *              gives Vbat in centivolts.
1686           **********************************************************************/
1687          uint16_t Get_Bat_Voltage_cV(void)   // unit: 0.01 V
1688          {
1689   1          uint32_t adc_avg;
1690   1          uint32_t vbat_cv;
1691   1      
1692   1      
1693   1          ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF reads VBGR against 
             -VDD - ratiometric Vbat math
1694   1          ADC_SelectChannel(ADC_VBGR);
1695   1          Delay_ms(1);
1696   1      
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 29  

1697   1          ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1698   1      
1699   1          adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1700   1      
1701   1          if (adc_avg == 0) {
1702   2              ADCCRL = 0x00;            /* cleanup before early return */
1703   2              return 0;
1704   2          }
1705   1      
1706   1          vbat_cv = ((uint32_t)VBGR_CV * ADC_FS) / adc_avg;
1707   1      
1708   1          // sanity clamp (optional)
1709   1          if (vbat_cv > 400) vbat_cv = 400;   // ignore impossible >4.00 V readings
1710   1      
1711   1          /* Cleanup: disable ADC module. (P0FSRL untouched - this function does
1712   1           * not change pin functions.) */
1713   1          ADCCRL = 0x00;
1714   1      
1715   1          return (uint16_t)vbat_cv;
1716   1      }
