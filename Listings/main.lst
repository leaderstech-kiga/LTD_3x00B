1098          void BeforeStop(void)
1099          {
1100   1        /* Defensive OPAMP disable before sleep.
1101   1         * Root cause was AMP_AUTO_DIS=0 in main.h + missing DELAY_TIME macro
1102   1         * which selected the OPAMP-enable branch in hw_initial. Both are now
1103   1         * fixed, but keep this write as a safety net in case future code
1104   1         * enables OPAMP and forgets to clear it before sleep. */
1105   1        AMPCR1 = 0x00;
1106   1        LDOCR  = 0x00;     /* defensive: LDO OFF in case ADC code forgot LDO_OFF */
1107   1      
1108   1        /* Defensive: drop audio amp / flash VCC / LEDs in case anything was
1109   1         * left on by the previous active-code path. */
1110   1        AUDIO_OFF;
1111   1        CVDD_OFF;
1112   1        LED_G_OFF;
1113   1        LED_R_OFF;
1114   1      
1115   1        OSCCR = 0x84;       /* LFIRC enable + HIRC disable */
1116   1        WDTCR = 0xA2;       /* WDT enable, INTERRUPT mode, LFIRC clock */
1117   1        WDTDR = 2;          /* ~0.192 s wake period */
1118   1        IE3 |= 0x08;        /* WDT interrupt enable */
1119   1      }
1120          //----------------------------------------------------------------------------
1121          void AfterStop(void)
1122          {
1123   1      
1124   1        IE3 &= ~(0x08);                     // WDT interrupt disable
1125   1        //WDTCR = 0x00;
1126   1        
1127   1        /*
1128   1      #ifdef SysClock_1MHZ  
1129   1        OSCCR = 0x08;                                            // System clock: 1MHz
1130   1      #else 
1131   1        OSCCR = 0x18;                                            // System clock: 4MHz
1132   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1133   1      #endif
1134   1        */
1135   1        OSCCR = 0x18;                                            // System clock: 4MHz
1136   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1137   1      }
