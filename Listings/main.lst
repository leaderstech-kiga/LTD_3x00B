1593          /**********************************************************************
1594           * @brief       TEMP_ADC - read NTC thermistor through AN3 with LDO23 on
1595           *              as reference. Looks up the result in Temp_Table[] and
1596           *              returns temperature in degrees C (clamped 0..100).
1597           **********************************************************************/
1598          uint16_t TEMP_ADC(void)
1599          {
1600   1        int Temp_adc_data= 0 , Temp_Data;
1601   1        int i;
1602   1      
1603   1        // Route AN3 (NTC divider) to ADC; OPAMPs disabled.
1604   1        P0FSRL  = 0
1605   1          | ( 2 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used          // SENSING IN ADC
1606   1          | ( 2 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used              // Temperature_AD
             -C
1607   1          | ( 2<< 2)        //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used        // BAT_ADC
1608   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used      // C_VDD
1609   1      
1610   1        OP0_Enable(FALSE);
1611   1        OP1_Enable(FALSE);
1612   1        LDO_ON;
1613   1        ADC_Initial(ADC_CLK_1M, ADC_SW_TRIG, ADC_LDO_REF, ADC_LSB);  // LDO_REF: NTC ratiometric measurement immu
             -ne to LDO drift
1614   1        ADC_SelectChannel(ADC_CH3);
1615   1        
1616   1        Delay_ms(1);
1617   1        
1618   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1619   1        
1620   1        LDO_OFF;
1621   1      
1622   1        Temp_adc_data = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1623   1        
1624   1        for(i=TEMP_OFFSET;i<(TEMP_OFFSET + 100);i++){
1625   2          if(Temp_Table[i] > Temp_adc_data){
1626   3            break;
1627   3          }
1628   2        }
1629   1        
1630   1        if(i == (TEMP_OFFSET + 100)){
1631   2          Temp_Data = 100;
1632   2        }
1633   1        else if (i==TEMP_OFFSET){
1634   2          Temp_Data = 0;
1635   2        }
1636   1        else{
1637   2          Temp_Data = i -TEMP_OFFSET - 1 ;
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 28  

1638   2        }
1639   1      
1640   1        /* Cleanup: disable ADC + restore P0FSRL to hw_initial baseline. */
1641   1        ADCCRL = 0x00;
1642   1        P0FSRL = 0
1643   1          | (1 << 6)        /* P03 = OP0OUT (hw_initial baseline) */
1644   1          | (1 << 4)        /* P02 = OP1P                          */
1645   1          | (1 << 2)        /* P01 = OP1N                          */
1646   1          | (0 << 0);       /* P00 = I/O                           */
1647   1      
1648   1        return Temp_Data;
1649   1      }
