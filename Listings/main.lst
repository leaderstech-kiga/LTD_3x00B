 977          uint8_t SPI_Memory_Check(void){
 978   1        
 979   1        uint8_t SystemStatus_Read;
 980   1        uint8_t deviceID[3];
 981   1        
 982   1          // SPI Memory Check
 983   1        // CVDD_ON drives P20 = 1, which is the C_VDD signal supplying VCC to
 984   1        // U3 (MX25L1006E). P20 is a regular GPIO output (~50 ohm), so the
 985   1        // flash supply rail (C14 decoupling) charges through that impedance.
 986   1        CVDD_ON;             // P20 = 1 -> C_VDD high -> flash VCC ON
 987   1      
 988   1        // Wait for flash VCC to settle after C_VDD goes high (10 uF cap
 989   1        // on the rail charges through the P20 GPIO output impedance).
 990   1        NOP_20us_Delay(500);  // ~10 ms settle time for 10 uF flash VCC
 991   1      
 992   1        // SPI Initial
 993   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
 994   1      
 995   1        Get_Identification(deviceID);
 996   1      
 997   1        // Match expected MX25L1006E JEDEC ID + verify no SPI timeout
 998   1        // (so a 0xFF-on-each-byte timeout doesn't look like a partial match).
 999   1        if( (deviceID[0]==0xC2)&&(deviceID[1]==0x20)&&(deviceID[2]==0x11) && (SPI_Timeout == 0) )
1000   1        {
1001   2          SystemStatus_Read=1;
1002   2        }
1003   1        else{
1004   2          SystemStatus_Read=0;
1005   2        }
1006   1      
1007   1        CVDD_OFF;
1008   1        
1009   1          if(SystemStatus_Read == 1){
1010   2          
1011   2          LED_G_ON;
1012   2          Delay_ms(50);
1013   2          LED_G_OFF;
1014   2          
1015   2        }
1016   1        else{
1017   2          
1018   2          LED_R_ON;
1019   2          Delay_ms(50);
1020   2          LED_R_OFF;
1021   2        }
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 18  

1022   1        
1023   1        
1024   1        Delay_ms(100);
1025   1        LED_G_ON;
