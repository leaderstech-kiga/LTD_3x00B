1515          /**********************************************************************
1516           * @brief       Get_Bat_Voltage_cV - measure battery voltage in units of
1517           *              0.01 V (e.g. return value 304 == 3.04 V).
1518           *              Reads the internal VBGR reference against VDD as ADC ref
1519           *              (ratiometric trick): VBGR_CV is the calibrated bandgap *100,
1520           *              ADC_FS = 1024 (10-bit FS), and the formula
1521           *                  Vbat_cv = (VBGR_CV * ADC_FS) / adc_reading
1522           *              gives Vbat in centivolts.
1523           **********************************************************************/
1524          uint16_t Get_Bat_Voltage_cV(void)   // unit: 0.01 V
1525          {
1526   1          uint32_t adc_avg;
1527   1          uint32_t vbat_cv;
1528   1      
1529   1      
1530   1          ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);   // INTERNAL_REF reads VBGR against 
             -VDD - ratiometric Vbat math
1531   1          ADC_SelectChannel(ADC_VBGR);
1532   1          Delay_ms(1);
1533   1      
1534   1          ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);  // (FIX C1) was sizeof(...) = bytes
1535   1      
1536   1          adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT) /* (FIX C1) was sizeof */;
1537   1      
1538   1          if (adc_avg == 0) {
1539   2              ADCCRL = 0x00;            /* cleanup before early return */
1540   2              return 0;
1541   2          }
1542   1      
1543   1          vbat_cv = ((uint32_t)VBGR_CV * ADC_FS) / adc_avg;
1544   1      
1545   1          // sanity clamp (optional)
1546   1          if (vbat_cv > 400) vbat_cv = 400;   // ignore impossible >4.00 V readings
1547   1      
1548   1          /* Cleanup: disable ADC module. (P0FSRL untouched - this function does
1549   1           * not change pin functions.) */
1550   1          ADCCRL = 0x00;
1551   1      
1552   1          return (uint16_t)vbat_cv;
1553   1      }
1554          
1555          /**********************************************************************
1556           * @brief   Dust_1ADC
1557           * @param     None
1558           * @return  None
1559           **********************************************************************/
1560          
1561          uint16_t Dust_ADC_1AMP(void)
1562          {
1563   1        uint16_t Dust_adc_data = 0;
1564   1        uint32_t adc_avg;
1565   1        uint32_t op;
1566   1      
1567   1        /* Pin function map - same as 2AMP for consistency */
1568   1        P0FSRL  = 0
1569   1          | ( 1 << 6)       /* P03 : OP0OUT (sensing OP-amp output to ADC) */
1570   1          | ( 1 << 4)       /* P02 : OP1P  (unused here)                    */
1571   1          | ( 2 << 2)       /* P01 : AN1   (battery ADC channel)            */
1572   1          | ( 1 << 0);      /* P00 : OP1OUT (test point)                    */
1573   1      
1574   1        OPAMP_Initial(GAIN1_DIS, GAIN0_DIS, chp_125KHz);
1575   1        OP0_Enable(TRUE);
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 27  

1576   1        OP1_Enable(FALSE);
1577   1      
1578   1        ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);
1579   1        ADC_SelectChannel(ADC_VBGR);
1580   1        Delay_ms(1);
1581   1      
1582   1        /* 1) VBGR measurement -> ratiometric battery compensation factor.
1583   1         * ADC1_Bat_Val ~= 300 at VBAT=3V; used to scale the OP0OUT readings
1584   1         * so dust results stay constant across battery voltage drift. */
1585   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1586   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1587   1        if (adc_avg == 0) {
1588   2          goto cleanup;          /* divide-by-zero guard */
1589   2        }
1590   1        op  = 92;
1591   1        op *= 1024;
1592   1        op /= adc_avg;
1593   1        ADC1_Bat_Val = op;
1594   1      
1595   1        /* 2) LED ON - chamber sensing.
1596   1         * No divide-by-zero possible here (multiplication only, /1024 is the
1597   1         * only division). adc_avg=0 is a legitimate dark-chamber reading. */
1598   1        LDO_ON;
1599   1        ADC_SelectChannel(ADC_OP0OUT);
1600   1        Delay_ms(1);
1601   1      
1602   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1603   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1604   1      
1605   1        LDO_OFF;
1606   1        Delay_ms(1);
1607   1      
1608   1        op  = ADC1_Bat_Val;
1609   1        op *= adc_avg;
1610   1        op /= 1024;
1611   1        ADC1_On_Dust_Val = op;
1612   1      
1613   1        /* 3) LED OFF - ambient reference (still on ADC_OP0OUT) */
1614   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1615   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1616   1      
1617   1        op  = ADC1_Bat_Val;
1618   1        op *= adc_avg;
1619   1        op /= 1024;
1620   1        ADC1_Off_Dust_Val = op;
1621   1      
1622   1        /* Underflow guard: if optical noise pushes Off > On the uint16_t
1623   1         * subtraction would wrap to ~65535 and trigger a false fire alarm.
1624   1         * Treat that case as zero dust signal. */
1625   1        if (ADC1_On_Dust_Val > ADC1_Off_Dust_Val) {
1626   2          Dust_adc_data = ADC1_On_Dust_Val - ADC1_Off_Dust_Val;
1627   2        } else {
1628   2          Dust_adc_data = 0;
1629   2        }
1630   1      
1631   1      cleanup:
1632   1        /* Disable ADC + OPAMP + restore P0FSRL to hw_initial baseline so the
1633   1         * next call (or BeforeStop) inherits a clean state. */
1634   1        ADCCRL = 0x00;
1635   1        OP0_Enable(FALSE);
1636   1        OP1_Enable(FALSE);
1637   1        AMPCR1 = 0x00;
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 28  

1638   1        P0FSRL = 0
1639   1          | (1 << 6)        /* P03 = OP0OUT (baseline) */
1640   1          | (1 << 4)        /* P02 = OP1P              */
1641   1          | (1 << 2)        /* P01 = OP1N              */
1642   1          | (0 << 0);       /* P00 = I/O               */
1643   1      
1644   1        return Dust_adc_data;
1645   1      }
