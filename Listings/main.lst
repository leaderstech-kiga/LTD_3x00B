1648          /**********************************************************************
1649           * @brief   Dust_ADC_2amp
1650           * @param     None
1651           * @return  None
1652           **********************************************************************/
1653          
1654          uint16_t Dust_ADC_2AMP(void)
1655          {
1656   1        uint16_t Dust_adc_data = 0;
1657   1        uint32_t adc_avg;
1658   1        uint32_t op;
1659   1      
1660   1        /* Pin function map - same as 1AMP; OP-amp chain OP0 -> OP1 -> ADC */
1661   1        P0FSRL  = 0
1662   1          | ( 1 << 6)       /* P03 : OP0OUT (first stage out)             */
1663   1          | ( 1 << 4)       /* P02 : OP1P   (second stage non-inv input)  */
1664   1          | ( 2 << 2)       /* P01 : AN1    (battery ADC channel)         */
1665   1          | ( 1 << 0);      /* P00 : OP1OUT (final amp output, test pt)   */
1666   1      
1667   1        if (visual_type == 1) {
1668   2          OPAMP_Initial(GAIN1_X30, GAIN0_DIS, chp_125KHz);
1669   2        } else {
1670   2          OPAMP_Initial(GAIN1_X15, GAIN0_DIS, chp_125KHz);
1671   2        }
1672   1      
1673   1        /* Two-stage amp sequence: enable OP0 first, wait 200 us per User
1674   1         * Manual Figure 43 NOTE 2 ("turn on the first OP-AMP and provide a
1675   1         * delay of at least 200 us before turn on the second OP-AMP"), then
1676   1         * enable OP1. Without this delay the first sample is unreliable. */
1677   1        OP0_Enable(TRUE);
1678   1        NOP_20us_Delay(10);          /* ~200 us OP0 stabilization */
1679   1        OP1_Enable(TRUE);
1680   1      
1681   1        ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);
1682   1        ADC_SelectChannel(ADC_VBGR);
1683   1        Delay_ms(1);
1684   1      
1685   1        /* 1) VBGR measurement -> ratiometric battery compensation */
1686   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1687   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1688   1        if (adc_avg == 0) {
1689   2          goto cleanup;            /* divide-by-zero guard */
1690   2        }
1691   1        op  = 92;
1692   1        op *= 1024;
1693   1        op /= adc_avg;
1694   1        ADC2_Bat_Val = op;
1695   1      
1696   1        /* 2) LED ON - chamber sensing through 2-stage amp.
1697   1         * No divide-by-zero possible (multiplication only, /1024 is the only
1698   1         * division). adc_avg=0 is a legitimate dark-chamber reading. */
1699   1        LDO_ON;
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 29  

1700   1        ADC_SelectChannel(ADC_OP1OUT);
1701   1        Delay_ms(1);
1702   1      
1703   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1704   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1705   1      
1706   1        LDO_OFF;
1707   1        Delay_ms(1);
1708   1      
1709   1        op  = ADC2_Bat_Val;
1710   1        op *= adc_avg;
1711   1        op /= 1024;
1712   1        ADC2_On_Dust_Val = op;
1713   1      
1714   1        /* 3) LED OFF - ambient reference (still on ADC_OP1OUT) */
1715   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1716   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1717   1      
1718   1        op  = ADC2_Bat_Val;
1719   1        op *= adc_avg;
1720   1        op /= 1024;
1721   1        ADC2_Off_Dust_Val = op;
1722   1      
1723   1        /* Underflow guard - same rationale as Dust_ADC_1AMP */
1724   1        if (ADC2_On_Dust_Val > ADC2_Off_Dust_Val) {
1725   2          Dust_adc_data = ADC2_On_Dust_Val - ADC2_Off_Dust_Val;
1726   2        } else {
1727   2          Dust_adc_data = 0;
1728   2        }
1729   1      
1730   1      cleanup:
1731   1        ADCCRL = 0x00;
1732   1        OP0_Enable(FALSE);
1733   1        OP1_Enable(FALSE);
1734   1        AMPCR1 = 0x00;
1735   1        P0FSRL = 0
1736   1          | (1 << 6)        /* P03 = OP0OUT (baseline) */
1737   1          | (1 << 4)        /* P02 = OP1P              */
1738   1          | (1 << 2)        /* P01 = OP1N              */
1739   1          | (0 << 0);       /* P00 = I/O               */
1740   1      
1741   1        return Dust_adc_data;
1742   1      }
