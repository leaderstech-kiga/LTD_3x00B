 472          /**********************************************************************
 473           * @brief   main - standard C program entry point.
 474           * @param   None
 475           * @return  None
 476           **********************************************************************/
 477          void main(void)
 478          {
 479   1      
 480   1        //LDO_OFF;
 481   1        //CVDD_OFF;
 482   1        //AUDIO_OFF;
 483   1        system_count = 0;
 484   1      //  uart_debug_mode = uart_debug_On;
 485   1        uart_debug_mode = uart_debug_Off;
 486   1      
 487   1        hw_initial_Wait(10);
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 9   

 488   1      
 489   1       SystemStatus = SPI_Memory_Check();
 490   1      
 491   1        ADC_mode = Check_System();
 492   1      
 493   1        hw_initial_Wait(10);
 494   1        system_count = 0;
 495   1      
 496   1        SYS_mode =  Normal_mode;
 497   1      
 498   1        /* Boot / calibration initialisation (matches the existing product family).
 499   1         *
 500   1         *   STEP 1 - Power-on indication.
 501   1         *     calib_step1_boot_led(): LED_G + LED_R on together for 0.2 s.
 502   1         *
 503   1         *   STEP 2-1 - Flash erase + baseline capture (SW2 held at power-up).
 504   1         *     calib_erase_with_animation(): alternate G/R while held; on
 505   1         *     release erase the page, capture one clean-air baseline, save
 506   1         *     {baseline, gain=256} and set g_calib_needs_smoke = 1.
 507   1         *
 508   1         *   STEP 2-2 - Load (SW2 not held at power-up).
 509   1         *     calib_boot_init(): load baseline / gain_Q8 from DataFlash.
 510   1         *
 511   1         *   STEP 3 - Smoke gain calibration.
 512   1         *     Lives in the main loop (see the SW2 hold handler below):
 513   1         *     LED_R + release wait + place phase + 5-sample mean + gain save.
 514   1         */
 515   1      
 516   1        Port_SetInputpin(PORT1, PIN2, 1);
 517   1      
 518   1        /* STEP 1: power-on indication. */
 519   1        calib_step1_boot_led();
 520   1        
 521   1        if(uart_debug_mode == uart_debug_On){
 522   2          Uart_Out_Text( Boot_OK,11);
 523   2        }
 524   1      
 525   1      
 526   1        Delay_ms(300);
 527   1        if (Port_GetInputpinValue(PORT1, PIN2) == 0) {
 528   2          /* STEP 2-1: SW2 held -> erase + capture baseline + save. */
 529   2          calib_erase_with_animation();
 530   2        } else {
 531   2          /* STEP 2-2: SW2 not held -> load saved calibration. */
 532   2          calib_boot_init();
 533   2        }
 534   1        
 535   1        /* STEP 2 once before entering the loop (power LED + battery check). */
 536   1        Bat_mode = Bat_High_mode;
 537   1        LED_R_ON;
 538   1        Delay_ms(200);
 539   1        LED_R_OFF;
 540   1        battery_check();
 541   1        system_count = 1;   /* avoid count==0 immediately re-triggering STEP1/2 */
 542   1      
 543   1        hw_initial_Wait(10);
 544   1      
 545   1        while(1)
 546   1        {
 547   2      
 548   2          // Arm RESET-mode WDT (~2 s timeout) at the top of every loop
 549   2          // iteration for active-code hang protection. BeforeStop() swaps
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 10  

 550   2          // it back to INTERRUPT mode before Stop() so the wake timer
 551   2          // still works.
 552   2          WD_Reset();
 553   2      
 554   2        // =====================================================================
 555   2        // Main-loop procedure (STEP 1..5) - see docs/main_loop_design.md
 556   2        // Base wake/sleep behaviour: docs/wdt_periodic_v3.md
 557   2        // =====================================================================
 558   2      
 559   2          
 560   2        // STEP 1 - Fire monitoring (every FIRE_CHECK_CNT wakes, ~8.06 s)
 561   2        //////////////////////////////////////////////////////////////////////////////////////////
 562   2          if (system_count % FIRE_CHECK_CNT == 0) {
 563   3            fire_monitor_step();
 564   3          }
 565   2      
 566   2        // STEP 2 - Power LED + battery check (every LED_BAT_CNT wakes, ~56 s)
 567   2        //////////////////////////////////////////////////////////////////////////////////////////
 568   2          if (system_count % LED_BAT_CNT == 0) {
 569   3            LED_R_ON;
 570   3            Delay_ms(200);
 571   3            LED_R_OFF;
 572   3            battery_check();
 573   3          }
 574   2      
 575   2        // STEP 3 - Low-battery alarm repeat (every LOWBAT_ALARM_CNT wakes, ~280 s)
 576   2        //////////////////////////////////////////////////////////////////////////////////////////
 577   2          if (Bat_mode == Bat_Low_mode && (system_count % LOWBAT_ALARM_CNT == 0)) {
 578   3            lowbat_led_blink_start();
 579   3            Play_Clip(AUDIO_CLIP_LOWBAT);
 580   3            lowbat_led_blink_stop();
 581   3          }
 582   2      
 583   2        // STEP 4 - External interlock fire alarm (every wake)
 584   2        //////////////////////////////////////////////////////////////////////////////////////////
 585   2          Port_SetInputpin(PORT1, PIN0, 0);
 586   2          if (Port_GetInputpinValue(PORT1, PIN0) == 1) {
 587   3            LED_R_OFF;
 588   3            play_fire_burst(0);          /* external interlock: LED_R stays off */
 589   3            loop_wait_ms(2000);
 590   3          }
 591   2      
 592   2        // STEP 5 - Status check : SW2 held in Normal mode (every wake)
 593   2        //////////////////////////////////////////////////////////////////////////////////////////
 594   2          /* sample SW2 once; act only on a fresh press (released->pressed) so a held
 595   2           * button does not repeat the test/calibration each wake (long-press = one shot) */
 596   2          sw2_cur_pressed = (Port_GetInputpinValue(PORT1, PIN2) == 0) ? 1 : 0;
 597   2          if (SYS_mode == Normal_mode && sw2_cur_pressed && !sw2_prev_pressed) {
 598   3      
 599   3            if (g_calib_needs_smoke == 1) {
 600   4              calib_run_smoke();
 601   4              /* Production: the 12% smoke used for gain calibration is
 602   4               * still present, so run one fire-monitoring pass right away
 603   4               * to validate the alarm (voice + EMR_IO + LED) within the
 604   4               * same smoke injection. Only after a successful save - on a
 605   4               * reject g_calib_needs_smoke stays 1 and there is too little
 606   4               * smoke to confirm anyway. The alarm self-clears once the
 607   4               * smoke is removed. */
 608   4              if (g_calib_needs_smoke == 0) {
 609   5                
 610   5                  if(uart_debug_mode == uart_debug_On){
 611   6                    Uart_Out_Text( Cal_OK,10);
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 11  

 612   6                    Uart_Out();
 613   6                  }
 614   5                  
 615   5                fire_monitor_step();
 616   5              }
 617   4            } else {
 618   4              /* Calibrated: manual fire test - LED_R blinks at 0.5 s
 619   4               * (Timer2) during the voice playback. */
 620   4              Port_SetOutputpin(PORT1, PIN0, 0);
 621   4              P10 = 1;
 622   4              fire_led_blink_start();
 623   4              Play_Clip(AUDIO_CLIP_FIRE);   /* 1x */
 624   4              fire_led_blink_stop();
 625   4              //P10 = 0;  /* release: do NOT drive low; switch straight to input (Hi-Z) and let the external 220K pu
             -ll-down set EMR_IO low -> avoids a brief low-drive against another unit holding the shared interlock line high */
 626   4              Port_SetInputpin(PORT1, PIN0, 0);
 627   4            }
 628   3          }
 629   2      
 630   2      
 631   2          sw2_prev_pressed = sw2_cur_pressed;  /* remember SW2 state for next-wake edge detect */
 632   2      
 633   2        system_count++;
 634   2      
 635   2          // Sleep cycle: BeforeStop arms WDT as INTERRUPT-mode wake timer
 636   2          // (WDTDR=2, ~0.192 s) for button-polling resolution.
 637   2          // After wake, the top-of-loop WD_Reset() switches WDT back to
 638   2          // RESET mode for the next iteration's hang protection.
 639   2        BeforeStop();
 640   2        GLOBAL_INTERRUPT_EN();
 641   2        Stop();
 642   2        AfterStop();
 643   2      
 644   2        }
 645   1      }
