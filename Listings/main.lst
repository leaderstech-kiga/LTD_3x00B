1203   3      
1204   3            if (Audio_length == prev_length) {
1205   4              /* No progress this iteration. ~4 us per while iter at 4 MHz,
1206   4               * so 50000 iterations ~= 200 ms of no progress = stall. */
1207   4              if (++stall_count > 50000) {
1208   5                break;
C51 COMPILER V9.54   MAIN                                                                  05/27/2026 12:19:59 PAGE 21  

1209   5              }
1210   4            } else {
1211   4              prev_length = Audio_length;
1212   4              stall_count = 0;
1213   4            }
1214   3          }
1215   2        }
1216   1      
1217   1        CVDD_OFF;
1218   1        AUDIO_OFF;
1219   1        
1220   1        //Port_SetOutputpin(PORT1, PIN0, 0);
1221   1        //P10 = 1;
1222   1        
1223   1        Audio_start = 0;
1224   1      }
