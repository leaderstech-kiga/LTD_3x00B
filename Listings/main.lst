1464          
1465          /**********************************************************************
1466           * @brief       Data_Avr - simple arithmetic mean over `count` ADC samples
1467           * @param       adc_data - pointer to array of uint16_t samples
1468           * @param       count    - number of elements (NOT bytes!)
1469           * @return      average value, or 0 if count==0
1470           **********************************************************************/
1471          uint16_t Data_Avr(uint16_t *adc_data, uint8_t count){
1472   1        
1473   1        uint32_t temp = 0;
1474   1        uint8_t i;
1475   1        
1476   1        if(count < 1){
1477   2          return 0;
1478   2        }
1479   1        
1480   1        for(i=0; i<count ; i++){
1481   2          temp = temp + adc_data[i];
1482   2        }
1483   1        
1484   1        temp = temp / count;
1485   1        
1486   1        return temp;
1487   1        
1488   1      }
1489          
1490          void Data_Sorting(uint16_t *adc_data, uint8_t count)
1491          {
1492   1        uint8_t i,j;
1493   1        uint16_t temp;
1494   1      
1495   1        if(count < 1){
1496   2          return;
1497   2        }
1498   1        
1499   1        for(i = 0; i < (count-1); i++)
1500   1        {
1501   2          for(j = i+1; j < count; j++)
1502   2          {
1503   3            
1504   3            if(adc_data[i] > adc_data[j])
1505   3            {
1506   4              temp = adc_data[i];
1507   4              adc_data[i]=adc_data[j];
1508   4              adc_data[j]=temp;
1509   4            }
1510   3          }
1511   2        }
1512   1      }
1513          
1514          uint16_t Data_TrimmedMean(uint16_t *adc_data, uint8_t count){
1515   1      
1516   1        uint32_t temp = 0;
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 26  

1517   1        uint8_t i;
1518   1        
1519   1        if(count < 3){
1520   2          return 0;
1521   2        }
1522   1        
1523   1        
1524   1        Data_Sorting(adc_data, count);
1525   1        
1526   1        for(i=1; i<(count -1) ; i++){
1527   2          temp = temp + adc_data[i];
1528   2        }
1529   1        
1530   1        temp = temp / (count -2);
1531   1        
1532   1        return temp;
1533   1        
1534   1      }
