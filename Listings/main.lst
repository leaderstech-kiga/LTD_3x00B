1400   1      
1401   1        /* This runs right after fire-voice playback (play_fire_burst -> Audio_Run),
1402   1         * which left the USART block in SPI (synchronous) mode. USART_Initial()
1403   1         * skips its block reset when coming from synchronous mode - its reset is
1404   1         * gated on (USTCR1 bit6 == 0) - so force SOFTRST here to cleanly switch the
1405   1         * block back to UART. Without this the first UART output after audio is
1406   1         * garbled / dropped. */
1407   1        USTST |= SOFTRST;
1408   1      
1409   1        USART_Initial(9600, USART_DATA_8BIT, USART_STOP_1BIT, USART_PARITY_NO, USART_TX_RX_MODE);
1410   1        
1411   1        if(ADC_mode == Dust_mode){
1412   2          
1413   2          if(visual_type == 1){
1414   3            USART_SendDataWithPolling(&Visu_MODE, sizeof(Visu_MODE));
1415   3          }
1416   2          else{
1417   3            USART_SendDataWithPolling(&Dust_MODE, sizeof(Dust_MODE));
1418   3          }
1419   2          USART_SendDataWithPolling(&Space, sizeof(Space));
1420   2          USART_SendDataWithPolling(&Dust_val, sizeof(Dust_val));
1421   2          USART_SendDataWithPolling(&Space, sizeof(Space));
1422   2          Uart_Out_Int(Value);
1423   2      
1424   2        }
1425   1        else if(ADC_mode == Temp_mode){
1426   2          USART_SendDataWithPolling(&Temp_MODE, sizeof(Temp_MODE));
1427   2          USART_SendDataWithPolling(&Space, sizeof(Space));
1428   2          Uart_Out_Int(Value);
1429   2        }
1430   1        
1431   1        USART_SendDataWithPolling(&End, 4);
1432   1        
1433   1        Port_SetAlterFunctionpin(PORT1, PIN2, 0);
1434   1      }
1435          
1436          
1437          void Uart_Out_Int(uint16_t Value){
1438   1      
1439   1        uint16_t int_val;
1440   1        uint8_t tmp;
1441   1        
1442   1        if(Value > 9999){
1443   2          Value = 9999;
1444   2        }
1445   1        
1446   1        tmp = Value / 1000 + 48;
1447   1        USART_SendDataWithPolling(&tmp, 1);
1448   1        int_val= Value % 1000 ;
1449   1        tmp = (int_val/ 100 )+ 48;
1450   1        USART_SendDataWithPolling(&tmp, 1);
1451   1        int_val= Value % 100 ;
1452   1        tmp = (int_val/ 10 )+ 48;
1453   1        USART_SendDataWithPolling(&tmp, 1);
1454   1        int_val= Value % 10 ;
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 16:26:20 PAGE 25  

1455   1        tmp = (int_val/ 1) + 48;
1456   1        USART_SendDataWithPolling(&tmp, 1);
1457   1      }
