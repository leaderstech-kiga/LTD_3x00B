1044          void BeforeStop(void)
1045          {
1046   1        /* Defensive OPAMP disable before sleep.
1047   1         * Root cause was AMP_AUTO_DIS=0 in main.h + missing DELAY_TIME macro
1048   1         * which selected the OPAMP-enable branch in hw_initial. Both are now
1049   1         * fixed, but keep this write as a safety net in case future code
1050   1         * enables OPAMP and forgets to clear it before sleep. */
1051   1        AMPCR1 = 0x00;
1052   1        LDOCR  = 0x00;     /* defensive: LDO OFF in case ADC code forgot LDO_OFF */
1053   1      
1054   1        /* Defensive: drop audio amp / flash VCC / LEDs in case anything was
1055   1         * left on by the previous active-code path. */
1056   1        AUDIO_OFF;
1057   1        CVDD_OFF;
1058   1        LED_G_OFF;
1059   1        LED_R_OFF;
1060   1      
1061   1        OSCCR = 0x84;       /* LFIRC enable + HIRC disable */
1062   1        WDTCR = 0xA2;       /* WDT enable, INTERRUPT mode, LFIRC clock */
1063   1        WDTDR = 2;          /* ~0.192 s wake period */
1064   1        IE3 |= 0x08;        /* WDT interrupt enable */
1065   1      }
1066          //----------------------------------------------------------------------------
1067          void AfterStop(void)
1068          {
1069   1      
1070   1        IE3 &= ~(0x08);                     // WDT interrupt disable
1071   1        //WDTCR = 0x00;
1072   1        
1073   1        /*
1074   1      #ifdef SysClock_1MHZ  
1075   1        OSCCR = 0x08;                                            // System clock: 1MHz
1076   1      #else 
1077   1        OSCCR = 0x18;                                            // System clock: 4MHz
1078   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1079   1      #endif
1080   1        */
1081   1        OSCCR = 0x18;                                            // System clock: 4MHz
1082   1                                                                // If 0x00/0x08/0x10/0x18, 0.5MHz/1MHz/2MHz/4MHz
1083   1      }
