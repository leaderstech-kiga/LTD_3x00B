1405   1        uint16_t int_val;
1406   1        uint8_t tmp;
1407   1        
1408   1        if(Value > 9999){
1409   2          Value = 9999;
1410   2        }
1411   1        
1412   1        tmp = Value / 1000 + 48;
1413   1        USART_SendDataWithPolling(&tmp, 1);
1414   1        int_val= Value % 1000 ;
1415   1        tmp = (int_val/ 100 )+ 48;
1416   1        USART_SendDataWithPolling(&tmp, 1);
1417   1        int_val= Value % 100 ;
1418   1        tmp = (int_val/ 10 )+ 48;
1419   1        USART_SendDataWithPolling(&tmp, 1);
1420   1        int_val= Value % 10 ;
1421   1        tmp = (int_val/ 1) + 48;
1422   1        USART_SendDataWithPolling(&tmp, 1);
1423   1      }
