1223          void Audio_Run(uint16_t Address , uint16_t Length,  uint8_t Run_time){
1224   1           
1225   1        CVDD_ON;
1226   1        AUDIO_ON; 
1227   1        
1228   1        Audio_start = 1;
1229   1      
1230   1        P2 = 0x01;
1231   1        /* SPI Initial */
1232   1        USART_SPI_Initial(SPI_MASTER_MODE, 500000, SPI_MSB, SPI_CPOL_LOW, SPI_CPHA_1EDGE, SPI_TX_RX_MODE, SPI_SS_
             -HW_DISABLE);   // 500000
1233   1        
1234   1        NOP_20us_Delay(5000);         // 0.1sec
1235   1        NOP_20us_Delay(5000);         // 0.1sec
1236   1        NOP_20us_Delay(5000);         // 0.1sec
1237   1        
1238   1        Audio_max_length = Length;
1239   1        Variable_Initial(Address);
1240   1        
1241   1          /* Audio Initial */
1242   1        Audio_Initial();  
1243   1        
1244   1        NOP_20us_Delay(1000);         // 0.02sec
1245   1        NOP_20us_Delay(1000);         // 0.02sec
1246   1        NOP_20us_Delay(1000);         // 0.02sec
1247   1        
1248   1        
1249   1        Timer1_Start();
1250   1      
1251   1        // Audio clips run ~3 seconds (Audio3_length=24324 samples @ 8 kHz =
1252   1        // 3.04 s) which exceeds the 2-s active-mode WDT timeout. Refresh the
1253   1        // watchdog inside this polling loop so playback is not aborted by a
1254   1        // false WDT reset. The CPU is otherwise idle here while the
1255   1        // TIMER1_Int ISR feeds samples in the background.
1256   1        //
1257   1        // Stall detector.
1258   1        //
1259   1        // The WD_Reset() inside this loop also means the active-mode WDT will
1260   1        // NEVER fire here, even if the audio ISR stops making progress
1261   1        // (Audio_length not incrementing because of e.g. SPI fault, SPI clock
1262   1        // glitch, TIMER1_Int disabled). The loop would then spin forever and
1263   1        // the device would appear hung from the outside.
1264   1        //
1265   1        // We track Audio_length progress and bail out if it does not advance
1266   1        // for ~200 ms. At ~125 us per audio sample the ISR should increment
1267   1        // Audio_length about 1600 times during 200 ms, so 200 ms of zero
1268   1        // progress is unambiguous evidence of a stall.
1269   1        {
1270   2          uint16_t prev_length  = 0xFFFF;   /* sentinel - guaranteed != on first iter */
C51 COMPILER V9.54   MAIN                                                                  06/01/2026 10:22:12 PAGE 22  

1271   2          uint16_t stall_count  = 0;
1272   2      
1273   2          while (Audio_length < Audio_max_length) {
1274   3            WD_Reset();                   /* kick dog during long playback */
1275   3      
1276   3            if (Audio_length == prev_length) {
1277   4              /* No progress this iteration. ~4 us per while iter at 4 MHz,
1278   4               * so 50000 iterations ~= 200 ms of no progress = stall. */
1279   4              if (++stall_count > 50000) {
1280   5                break;
1281   5              }
1282   4            } else {
1283   4              prev_length = Audio_length;
1284   4              stall_count = 0;
1285   4            }
1286   3          }
1287   2        }
1288   1      
1289   1        CVDD_OFF;
1290   1        AUDIO_OFF;
1291   1        
1292   1        //Port_SetOutputpin(PORT1, PIN0, 0);
1293   1        //P10 = 1;
1294   1        
1295   1        Audio_start = 0;
1296   1      }
