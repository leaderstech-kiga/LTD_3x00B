1166          /**********************************************************************
1167           * @brief   WD_Reset - configure WDT in RESET mode for hang protection.
1168           *
1169           *   Purpose: while the MCU is awake and executing code, the WDT must be
1170           *   armed in RESET mode so that any hang (stuck SPI poll, infinite loop,
1171           *   ISR deadlock, EMI-induced PC corruption, etc.) triggers an automatic
1172           *   MCU reset rather than leaving the device silently dead. Safety-
1173           *   critical for a fire detector.
1174           *
1175           *   The complementary wake-from-Stop timer (BeforeStop) keeps WDT in
1176           *   INTERRUPT mode with WDTDR=2 (~0.192 s). On every wake we call this
1177           *   function to switch WDT into RESET mode with the longer timeout;
1178           *   BeforeStop will switch it back before the next Stop.
1179           *
1180           *   Behaviour:
1181           *     - Clock source : WDTRC (~3.072 MHz internal, independent of MCLK)
1182           *     - Timeout      : WDTDR = 30  ->  approximately 2 seconds.
1183           *                      Long enough to cover normal active code paths
1184           *                      (Dust_ADC_Single, Delay_ms(100), hw_initial_Wait,
1185           *                      etc.); shorter than the time a real hang would
1186           *                      take to be noticeable. Longer blocking calls
1187           *                      (Audio_Run audio playback, Fire_Alarm loop) must
1188           *                      refresh the counter by calling WD_Reset()
1189           *                      themselves - see those functions below.
1190           *     - Mode         : RESET (WDTCR bit 6 set) -> MCU reset on overflow.
1191           *
1192           *   Note: WDTCR also has bit 5 (WDTCL) set, which clears the counter on
1193           *   every write, so each WD_Reset() call effectively "kicks the dog".
1194           **********************************************************************/
1195          void WD_Reset(void)
1196          {
1197   1        WDTDR = 30;                       // ~2 sec active-mode timeout
1198   1        //WDTCR = 0xA3;                     // set WDT enable , clock source LFIRC, WDT interrupt
1199   1        //WDTCR = 0xE5;                     // WDT enable, RESET mode (bit6=1), WDTRC clock, clear counter
1200   1        WDTCR = 0xE3;     /* 11100011: WDTEN=1, RESET mode, WDTCL=1, WDTCK=01 (LFIRC) */
1201   1        IE3 |= 0x08;                      // WDT interrupt enable (no effect in reset mode but harmless)
1202   1      }
1203          
1204          void WDT_Int(void) interrupt WDT_VECT
1205          {
1206   1        WDTCR &= ~0x01;
1207   1      }
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 21  

