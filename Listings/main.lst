1718          /**********************************************************************
1719           * @brief   Dust_1ADC
1720           * @param     None
1721           * @return  None
1722           **********************************************************************/
1723          
1724          uint16_t Dust_ADC_1AMP(void)
1725          {
1726   1        uint16_t Dust_adc_data = 0;
1727   1        uint32_t adc_avg;
1728   1        uint32_t op;
1729   1      
1730   1        /* Pin function map - same as 2AMP for consistency */
1731   1        P0FSRL  = 0
1732   1          | ( 1 << 6)       /* P03 : OP0OUT (sensing OP-amp output to ADC) */
1733   1          | ( 1 << 4)       /* P02 : OP1P  (unused here)                    */
1734   1          | ( 2 << 2)       /* P01 : AN1   (battery ADC channel)            */
1735   1          | ( 1 << 0);      /* P00 : OP1OUT (test point)                    */
1736   1      
1737   1        OPAMP_Initial(GAIN1_DIS, GAIN0_DIS, chp_125KHz);
1738   1        OP0_Enable(TRUE);
1739   1        OP1_Enable(FALSE);
1740   1      
1741   1        ADC_Initial(ADC_CLK_2M, ADC_SW_TRIG, ADC_INTERNAL_REF, ADC_LSB);
1742   1        ADC_SelectChannel(ADC_VBGR);
1743   1        Delay_ms(1);
1744   1      
1745   1        /* 1) VBGR measurement -> ratiometric battery compensation factor.
1746   1         * ADC1_Bat_Val ~= 300 at VBAT=3V; used to scale the OP0OUT readings
1747   1         * so dust results stay constant across battery voltage drift. */
1748   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1749   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1750   1        if (adc_avg == 0) {
1751   2          goto cleanup;          /* divide-by-zero guard */
1752   2        }
1753   1        op  = 92;
1754   1        op *= 1024;
1755   1        op /= adc_avg;
1756   1        ADC1_Bat_Val = op;
1757   1      
1758   1        /* 2) LED ON - chamber sensing.
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 08:42:20 PAGE 30  

1759   1         * No divide-by-zero possible here (multiplication only, /1024 is the
1760   1         * only division). adc_avg=0 is a legitimate dark-chamber reading. */
1761   1        LDO_ON;
1762   1        ADC_SelectChannel(ADC_OP0OUT);
1763   1        Delay_ms(1);
1764   1      
1765   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1766   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1767   1      
1768   1        LDO_OFF;
1769   1        Delay_ms(1);
1770   1      
1771   1        op  = ADC1_Bat_Val;
1772   1        op *= adc_avg;
1773   1        op /= 1024;
1774   1        ADC1_On_Dust_Val = op;
1775   1      
1776   1        /* 3) LED OFF - ambient reference (still on ADC_OP0OUT) */
1777   1        ADC_GetDataWithPolling(ADC_temp_data, ADC_BUFFER_COUNT);
1778   1        adc_avg = Data_TrimmedMean(ADC_temp_data, ADC_BUFFER_COUNT);
1779   1      
1780   1        op  = ADC1_Bat_Val;
1781   1        op *= adc_avg;
1782   1        op /= 1024;
1783   1        ADC1_Off_Dust_Val = op;
1784   1      
1785   1        /* Underflow guard: if optical noise pushes Off > On the uint16_t
1786   1         * subtraction would wrap to ~65535 and trigger a false fire alarm.
1787   1         * Treat that case as zero dust signal. */
1788   1        if (ADC1_On_Dust_Val > ADC1_Off_Dust_Val) {
1789   2          Dust_adc_data = ADC1_On_Dust_Val - ADC1_Off_Dust_Val;
1790   2        } else {
1791   2          Dust_adc_data = 0;
1792   2        }
1793   1      
1794   1      cleanup:
1795   1        /* Disable ADC + OPAMP + restore P0FSRL to hw_initial baseline so the
1796   1         * next call (or BeforeStop) inherits a clean state. */
1797   1        ADCCRL = 0x00;
1798   1        OP0_Enable(FALSE);
1799   1        OP1_Enable(FALSE);
1800   1        AMPCR1 = 0x00;
1801   1        P0FSRL = 0
1802   1          | (1 << 6)        /* P03 = OP0OUT (baseline) */
1803   1          | (1 << 4)        /* P02 = OP1P              */
1804   1          | (1 << 2)        /* P01 = OP1N              */
1805   1          | (0 << 0);       /* P00 = I/O               */
1806   1      
1807   1        return Dust_adc_data;
1808   1      }
