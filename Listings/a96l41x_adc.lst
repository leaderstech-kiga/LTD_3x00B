  59          /**
  60          * @brief    Initialize ADC peripheral
  61          * @param   clock_sel      This parameter contains the selection of ADC converter clock (fx <= 8MHz).
  62          *
  63          *     - ADC_CLK_4M    = 0
  64          *     - ADC_CLK_2M    = 1
  65          *     - ADC_CLK_1M    = 2
  66          *     - ADC_CLK_0_5M    = 3
  67          * @param   trigger_sel    This parameter contains the selection of ADC trigger source.
  68          *
  69          *     - ADC_SW_TRIG   = 0
  70          *     - ADC_T0_TRIG     = 1
  71          * @param   ref_voltage    This parameter contains the selection of ADC reference voltage.
  72          *
  73          *     - ADC_INTERNAL_REF  = 0
  74          *     - ADC_LDO_REF   = 1
  75          * @param   align_sel    This parameter contains the selection of ADC data align. 
  76          *
  77          *     - ADC_MSB       = 0
  78          *     - ADC_LSB       = 1
  79          * @return   None
  80          */
  81          void ADC_Initial(uint8_t clock_sel, uint8_t trigger_sel, uint8_t ref_voltage, uint8_t align_sel)
  82          {
  83   1          /*  The A/D converter needs at least 14 us for conversion time.
  84   1              So you must set the conversion time more than 14 us.
  85   1              If the ADC conversion time is set short, the resolution is degraded.
  86   1          
  87   1              ** ADC Conversion clock = ADCLK * 28 clocks
  88   1              
  89   1          Example)
  90   1              fx=2Mhz, CKSEL = 2M,  ADC Clock source(@2Mhz) = 0.5us
  91   1              28 clock x 0.5us = 14us at 2Mhz
  92   1          */
  93   1        uint8_t temp_reg, temp_reg2;
  94   1        
  95   1          if(clock_sel == 0){
  96   2          clock_sel =1;
  97   2        }
  98   1          
  99   1        temp_reg = ADCCRH;
 100   1        temp_reg &= ~(0xFF);
 101   1        temp_reg |= ((trigger_sel << 3) | (align_sel << 2) | (clock_sel << 0));
 102   1        
 103   1        temp_reg2 = ADCCRL;
 104   1        temp_reg2 &= ~(0xFF);
 105   1        temp_reg2 |= ((1 << 7) | (ref_voltage << 5));  //ADC Enable + ref_Voltage
 106   1        
 107   1        ADCCRH = temp_reg;
 108   1        ADCCRL = temp_reg2;
 109   1        
 110   1        /* If the ADC clock is more than 4MHz, ADC module is not initialized. 
 111   1           To meet the conversion time spec value, adc clock is under 2MHz recommended.
 112   1        */
 113   1        /*
 114   1        while( (clock_sel >= 1) )
 115   1        {
 116   1          NOP;  // NOTE : clock_sel <= 2Mhz
C51 COMPILER V9.54   A96L41X_ADC                                                           06/05/2026 08:42:18 PAGE 3   

 117   1        }
 118   1      */
 119   1      
 120   1          
 121   1      }
 122          
 123          /**
 124          * @brief    Enables the ADC Start conversion(For software trigger).
 125          * @param      None
 126          * @return   None
 127          */
 128          void ADC_StartSoftwareTrigger()
 129          {
 130   1        ADCCRL |= (1 << 6);
 131   1      }
 132          
 133          /**
 134          * @brief    Select the ADC Converter Input Channel.
 135          * @param   channel    This parameter contains the channel of ADC input.
 136          *
 137          *     - ADC_CH0   = 0
 138          *     - ADC_CH1   = 1
 139          *     - ADC_CH2   = 2
 140          *     - ADC_CH3   = 3
 141          *     - ADC_CH4   = 4
 142          *     - ADC_CH5   = 5
 143          *     - ADC_CH6   = 6
 144          *     - ADC_OP0OUT  = 9
 145          *     - ADC_OP1OUT  = 10
 146          *     - ADC_VBGR  = 15
 147          * @return   None
 148          */
 149          void ADC_SelectChannel(uint8_t channel)
 150          {
 151   1        uint8_t temp_reg;
 152   1        
 153   1        temp_reg = ADCCRL;
 154   1        temp_reg &= ~(0xF << 0);
 155   1        temp_reg |= channel;
 156   1        
 157   1        ADCCRL = temp_reg;
 158   1      }
 159          
 160          /**
 161          * @brief    Get status of ADC conversion.
 162          * @param   None
 163          * @return   Status of ADC conversion flag.
 164          */
 165          uint8_t ADC_GetConversionStatus()
 166          {
 167   1        return (ADCCRL & 0x10);
 168   1      }
 169          
 170          /**
 171          * @brief   Get data of ADC conversion via polling.
 172          *          Each conversion-wait loop is bounded by a ~0x2000 iteration
 173          *          limit; ADC_Timeout is set on timeout so the caller can
 174          *          distinguish a real reading from a stuck-ADC sample.
 175          * @param   adc_data    pointer to buffer that receives the samples.
 176          * @param   count       number of samples to collect (1 .. buffer_size).
 177          * @return  None - check ADC_Timeout after the call.
 178          */
C51 COMPILER V9.54   A96L41X_ADC                                                           06/05/2026 08:42:18 PAGE 4   

 179          void ADC_GetDataWithPolling(uint16_t *adc_data, uint8_t count)
 180          {
 181   1        uint8_t  i;
 182   1        uint16_t wait;
 183   1      
 184   1        for(i = 0; i < count; i++)
 185   1        {
 186   2          if( ((ADCCRH & 0x08) == 0x00) )  /* SW trigger */
 187   2            ADC_StartSoftwareTrigger();
 188   2      
 189   2          wait = 0x2000;
 190   2          while((!(ADC_GetConversionStatus())) && (--wait));
 191   2          if (wait == 0) {
 192   3            ADC_Timeout = 1;
 193   3            return;
 194   3          }
 195   2      
 196   2          adc_data[i] = ADCDR;
 197   2        }
 198   1      
 199   1        ADC_Timeout = 0;
 200   1      }
 201          
 202          /*  Removed together with the interrupt path:
 203           *   ADC_ConfigureInterrupt   - only called by ADC_GetDataWithInterrupt
 204           *   ADC_ClearInterruptStatus - no callers
 205           *   ADC_Int_Handler          - ADC_VECT ISR, IE1.0 is never enabled so it
 206           *                              would never fire anyway.
 207           * See git history if the interrupt mode is ever needed. */
