 117   2          DATAFLASH_Exit();
 118   2        }
 119   1        else if (u32UserId == 0xA39B71D6) {
 120   2          pagebuffer[(unsigned char)(u16Addr & 0x0f)] = u8Byte;
 121   2          DFSADRH = (unsigned char)(u16Addr >> 8);
 122   2          DFSADRL = (unsigned char)(u16Addr >> 0);
 123   2          DFMCR   = DF_SEC_WT;
 124   2          _nop_();
 125   2          _nop_();
