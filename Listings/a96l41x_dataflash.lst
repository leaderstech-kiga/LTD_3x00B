 135          /**
 136          * @brief  Clear the 32-byte page buffer, then fill it according to mode.
 137          *           - DATAFLASH_SECTOR_WRITE : copy 32 bytes from u8Buf.
 138          *           - DATAFLASH_ERASE        : fill with 0x00.
 139          * @return DATAFLASH_PGM_GOOD on success, DATAFLASH_PGM_FAIL on bad mode.
 140          */
 141          unsigned char Buffer_clear(unsigned char u8FncSel, unsigned char *u8Buf) {
 142   1        unsigned char i;
 143   1        unsigned char xdata *pagebuffer = (unsigned char xdata *)0x7000;
 144   1      
 145   1        DFMCR = DATAFLASH_CLR_PAGEBUF;
 146   1        _nop_();
 147   1        _nop_();
 148   1        _nop_();
 149   1        for (i = 0; i < SECTOR_SIZE_BYTE; i++) {
 150   2          if (u8FncSel == DATAFLASH_SECTOR_WRITE) {
 151   3            pagebuffer[i] = *u8Buf++;
 152   3          }
 153   2          else if (u8FncSel == DATAFLASH_ERASE) {
 154   3            pagebuffer[i] = 0x00;
 155   3          }
 156   2          else {
 157   3            return DATAFLASH_PGM_FAIL;
 158   3          }
 159   2        }
 160   1        return DATAFLASH_PGM_GOOD;
 161   1      }
