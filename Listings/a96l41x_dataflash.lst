 112   1        _nop_();
 113   1        _nop_();
 114   1      
 115   1        DFIDR = DATAFLASH_id_reg ^ DATAFLASH_IDXOR;
 116   1        if ((u16Addr < 0x3000) || (u16Addr > 0x30FF)) {
