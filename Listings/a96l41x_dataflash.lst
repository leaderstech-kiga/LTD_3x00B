 101          /**
 102          * @brief  Single-byte write (used for sparse updates).
 103          * @param  u32UserId : magic 0xA39B71D6.
 104          */
 105          void DATAFLASH_ByteWt(unsigned long u32UserId, unsigned short u16Addr, unsigned char u8Byte) {
 106   1        unsigned char xdata *pagebuffer = (unsigned char xdata *)0x7000;
 107   1      
 108   1        DATAFLASH_Entry();
 109   1      
 110   1        DFMCR = DATAFLASH_CLR_PAGEBUF;
