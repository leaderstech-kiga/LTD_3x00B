  83          /**
  84          * @brief  Erase operation of dataflash.
  85          * @param    u32UserId   This parameter contains the UserID of DataFlash.
  86          *
  87          *         - safety code for operation of DataFlash
  88          * @param    u16Addr   This parameter contains the address of DataFlash.
  89          *
  90          *         - address range : 256 bytes (0x3000 ~ 0x30FF)
  91          * @return None
  92          */
  93          void DATAFLASH_PageEr(unsigned long u32UserId, unsigned short u16Addr) {
  94   1        unsigned char result;
  95   1        
  96   1        DATAFLASH_Entry();
  97   1        result = Buffer_clear(DATAFLASH_ERASE, 0);
  98   1        DFIDR = DATAFLASH_id_reg^DATAFLASH_IDXOR;                                     // Identification Value
  99   1        if((u16Addr<0x3000)||(u16Addr>0x30E0)) DATAFLASH_Exit();
 100   1        else if((u32UserId == 0xA901358F)&&(result!=DATAFLASH_PGM_FAIL)) {         // Ex) 0xA901358F, The user ID
             - may be changed by programmer
 101   2          DFSADRH = (unsigned char)(u16Addr>>8);
 102   2          DFSADRL = (unsigned char)(u16Addr>>0);
 103   2          DFMCR = DF_SEC_ER;
 104   2          _nop_();
 105   2            _nop_();
 106   2            _nop_();
 107   2            DATAFLASH_Exit();
 108   2            DATAFLASH_OPR_FLAG = DATAFLASH_PGM_ONGOING;
 109   2        }
 110   1        else {
 111   2          DATAFLASH_Exit();
 112   2        }
 113   1      }
