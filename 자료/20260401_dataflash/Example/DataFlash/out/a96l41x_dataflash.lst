 190          /**
 191          * @brief  Buffer clear operation of dataflash.
 192          * @param    u8FncSel  This parameter contains the mode function select of DataFlash.
 193          *         - Sector erase, Sector write
 194          * @param    u8Buf   This parameter contains the data of DataFlash.
 195          * @return DATAFLASH_PGM_GOOD
 196          */
 197          unsigned char Buffer_clear(unsigned char u8FncSel, unsigned char *u8Buf) {
 198   1        unsigned char i;
 199   1        unsigned char xdata *pagebuffer=0x7000;
 200   1        
 201   1        DFMCR = DATAFLASH_CLR_PAGEBUF;                                             // Clear sector buffer
 202   1        _nop_();
 203   1        _nop_();
 204   1        _nop_();
 205   1        for(i=0 ; i < SECTOR_SIZE_BYTE ; i++) {
 206   2          if(u8FncSel == DATAFLASH_SECTOR_WRITE) pagebuffer[i] = *u8Buf++;         // To sector write
 207   2          else if(u8FncSel == DATAFLASH_ERASE) pagebuffer[i] = 0x00;               // To sector erase
 208   2          else return DATAFLASH_PGM_FAIL;
 209   2        }
 210   1        return DATAFLASH_PGM_GOOD;
 211   1      }
