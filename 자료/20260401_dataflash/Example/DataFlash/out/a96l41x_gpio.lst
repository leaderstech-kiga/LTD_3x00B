 125          /**
 126          * @brief  Configures the selected port(x) pins as output pin.
 127          * @param    port  This parameter contains the pin port
 128          * @param    pin   This parameter contains the pin number
 129          * @param    mode  This parameter contains the pin mode(Push-Pull : 0, Open-Drain :1)
 130          * @return   None
 131          */
 132          void Port_SetOutputpin(uint8_t port, uint8_t pin, uint8_t mode)
 133          {
 134   1      
 135   1          switch(port)
 136   1          {
 137   2            case 0:
 138   2              P0IO |= (1<<pin);
 139   2              P0OD |= (mode<<pin);
 140   2            break;
 141   2            case 1:
 142   2              P1IO |= (1<<pin);
 143   2              P1OD |= (mode<<pin);
 144   2            break;
 145   2            case 2:
 146   2              P2IO |= (1<<pin);
 147   2              P2OD |= (mode<<pin);
 148   2            break;
 149   2            default:
 150   2            break;
 151   2          }
 152   1      }
