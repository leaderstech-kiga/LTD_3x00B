 189          void Port_SetAlterFunctionpin(uint8_t port, uint8_t pin, uint8_t val)
 190          {
 191   1        uint8_t temp_reg;
 192   1        
 193   1          switch(port)
 194   1          {
 195   2            case 0:
 196   2              if(pin > 0x3)
 197   2              {
 198   3                temp_reg = P0FSRH;
 199   3                temp_reg &= ~(0x3<<((pin-4)<<1));
 200   3                temp_reg |= (val<<((pin-4)<<1));
 201   3                
 202   3                P0FSRH = temp_reg;
 203   3              }
 204   2              else
 205   2              {
 206   3                temp_reg = P0FSRL;
 207   3                temp_reg &= ~(0x3<<(pin<<1));
 208   3                temp_reg |= (val<<(pin<<1));
 209   3                
 210   3                P0FSRL = temp_reg;
 211   3              }
 212   2            break;
 213   2            case 1:
 214   2              if(pin > 0x3)
 215   2              {
 216   3                temp_reg = P1FSRH;
 217   3                temp_reg &= ~(0x3<<((pin-4)<<1));
 218   3                temp_reg |= (val<<((pin-4)<<1));
 219   3                
 220   3                P1FSRH = temp_reg;
 221   3              }
 222   2              else
 223   2              {
 224   3                temp_reg = P1FSRL;
 225   3                temp_reg &= ~(0x3<<(pin<<1));
 226   3                temp_reg |= (val<<(pin<<1));  
 227   3      
 228   3                P1FSRL = temp_reg;
 229   3              } 
 230   2            break;
 231   2            case 2:
 232   2              if(pin > 0x1)
 233   2              {
 234   3                temp_reg = P2FSR;
 235   3                temp_reg  &= ~(1<<pin);
 236   3                temp_reg  |= (val<<pin);
 237   3                
 238   3                P2FSR = temp_reg;
 239   3              }
 240   2              else
C51 COMPILER V9.54   A96L41X_GPIO                                                          04/01/2026 22:05:16 PAGE 5   

 241   2              {
 242   3                temp_reg = P2FSR;
 243   3                temp_reg  &= ~(0x3<<(pin<<1));
 244   3                temp_reg  |= (val<<(pin<<1)); 
 245   3      
 246   3                P2FSR = temp_reg;
 247   3              }
 248   2            break;
 249   2            default:
 250   2            break;      
 251   2          }
 252   1      }
