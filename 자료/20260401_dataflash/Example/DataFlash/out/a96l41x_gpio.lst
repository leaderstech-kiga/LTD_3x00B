  57          /**
  58          * @brief  Initialize GPIO(PCU) peripheral
  59          * @param      None
  60          * @return   None
  61          */
  62          void Port_Initial(void)
  63          {
  64   1          // P0 setting
  65   1          P0    = _0000_0000;   // 0 : Low, 1 : High
  66   1          P0OD  = _0000_0000;   // 0 : Disable, 1 : Enable (Open-drain)
  67   1          P0PU  = _0000_0000;   // 0 : Disable, 1 : Enable (Pull-up)
  68   1          P0IO  = _1111_1111;   // 0 : Input, 1 : Output
  69   1          P0FSRH  = 0
  70   1          | ( 0 << 6)       //P07     // 0 : I/O (EINT3), 1 : ICS1
  71   1          | ( 0 << 4)       //P06     // 0 : I/O (EINT2), 1 : ICS0
  72   1          | ( 0 << 2)       //P05     // 0 : I/O, 1 : OP0P,    
  73   1          | ( 0 << 0);      //P04     // 0 : I/O, 1 : OP0N
  74   1          
  75   1          P0FSRL  = 0
  76   1          | ( 0 << 6)       //P03     // 0 : I/O, 1 : OP0OUT,   2 : AN3,      3 : Not used
  77   1          | ( 0 << 4)       //P02     // 0 : I/O, 1 : OP1P,   2 : AN2,      3 : Not used
  78   1          | ( 0 << 2)       //P01     // 0 : I/O (EINT1), 1 : OP1N,  2 : AN1, 3 : Not used
  79   1          | ( 0 << 0);      //P00     // 0 : I/O (EINT0), 1 : OP1OUT,   2 : AN0,  3 : Not used
  80   1          
  81   1          P0DB  = 0
  82   1          | ( 0 << 6)     //DBCLK[1:0]  // 00 : fx (SCLK),  01 : fx/4,  10 : fx/16, 11 : fx/64
  83   1          | ( 0 << 3)     //P07DB   // 0 : Disable, 1 : Enable
  84   1          | ( 0 << 2)     //P06DB   // 0 : Disable, 1 : Enable
  85   1          | ( 0 << 1)     //P01DB   // 0 : Disable, 1 : Enable
  86   1          | ( 0 << 0);    //P00DB   // 0 : Disable, 1 : Enable
  87   1          
  88   1          // P1 setting    
  89   1          P1    = _0000_0000;   // 0 : Low, 1 : High
  90   1          P1OD  = _0000_0000;   // 0 : Disable, 1 : Enable (Open-drain)
  91   1          P1PU  = _0000_0000;   // 0 : Disable, 1 : Enable (Pull-up)
  92   1          P1IO  = _0011_1111;   // 0 : Input, 1 : Output
  93   1          
  94   1          P1FSRH  = 0
  95   1          | ( 0 << 2)       //P15  // 0 : I/O,  1 : LDO23,   2 : AN6, 3 : (SDA)
  96   1          | ( 0 << 0);      //P14  // 0 : I/O (EINT11), 1 : T1O/PWM1O,   2 : SCL, 3 : Not used
  97   1          
  98   1          P1FSRL  = 0
  99   1          | ( 0 << 6)       //P13  // 0 : I/O (EC1),  1 : (RXD/MISO)
 100   1          | ( 0 << 4)       //P12  // 0 : I/O (EC0),  1 : (TXD/MOSI)
 101   1          | ( 0 << 2)       //P11  // 0 : I/O (EINT10), 1 : T0O/PWM0O
 102   1          | ( 0 << 0);      //P10  // 0 : I/O,  1 : (SCK)
 103   1      
 104   1          P12DB = 0
 105   1          | ( 0 << 5)     //P21DB   // 0 : Disable, 1 : Enable
 106   1          | ( 0 << 4)     //P20DB   // 0 : Disable, 1 : Enable
 107   1          | ( 0 << 2)     //P14DB   // 0 : Disable, 1 : Enable
 108   1          | ( 0 << 1)     //P11DB   // 0 : Disable, 1 : Enable
 109   1          | ( 0 << 0);      //P10DB   // 0 : Disable, 1 : Enable
 110   1      
 111   1          // P2 setting    
 112   1          P2  = _0000_0000;   // 0 : Low, 1 : High
 113   1          P2OD  = _0000_0000;   // 0 : Disable, 1 : Enable (Open-drain)
 114   1          P2PU  = _0000_0000;   // 0 : Disable, 1 : Enable (Pull-up)
 115   1          P2IO  = _0000_1111;   // 0 : Input, 1 : Output
 116   1          
C51 COMPILER V9.54   A96L41X_GPIO                                                          04/01/2026 22:05:16 PAGE 3   

 117   1          P2FSR   = 0
 118   1          | ( 0 << 6)     // 0 : P23,  1 : TXD/MOSI,  2 : AN5,     3 : Not used
 119   1          | ( 0 << 4)     // 0 : P22,  1 : RXD/MISO,  2 : AN4,     3 : Not used
 120   1          | ( 0 << 2)         // 0 : P21 (EC2),  1 : SCK,   2 : (SCL),     3 : Not used
 121   1          | ( 0 << 0);        // 0 : P20 (EINT12),  1 : T2O/PWM2O,   2 : SDA,     3 : Not used
 122   1      
 123   1      }
