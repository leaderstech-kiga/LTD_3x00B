                      }
                      DATAFLASH_ByteWt(dataflash_id, dataflash_addr, dataflash_data[(unsigned char)(dataflash_addr&0x000f)])
             -;
              
                      dataflash_addr++;
                      dataflash_addr &= 0x007f;
              
                      if((dataflash_addr&0x000f) == 0) DF_WT_FLAG = DF_RD;
              #endif
 153   4              }
