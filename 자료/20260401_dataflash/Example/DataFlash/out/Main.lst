 122   4              dataflash_id = 0xA901358F;
 123   4              dataflash_addr = 0x3000;
 124   4              DATAFLASH_PageEr(dataflash_id, dataflash_addr);
 125   4              DF_WT_FLAG = DF_ER;
 126   4                 }
 127   3            else if(DF_WT_FLAG == DF_ER)
