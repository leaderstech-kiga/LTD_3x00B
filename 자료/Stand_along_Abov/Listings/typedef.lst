  93          //  Macro Functions Definitions
  94          #define REG_SET(reg, byte)      (reg |= byte)
  95          #define REG_CLR(reg, byte)      (reg &= byte)
  96          #define SET_BIT(Variable,Place)  ((Variable) |= (INT8U)((INT8U)1<<(INT8U)(Place)))
  97          #define CLR_BIT(Variable,Place)  ((Variable) &= (INT8U)((INT8U)((INT8U)1<<(INT8U)(Place))^(INT8U)0xFF))
  98          #define TOGGLE_BIT(Variable,Place)  ((Variable) ^= (INT8U)((INT8U)1<<(INT8U)(Place)))
  99          
