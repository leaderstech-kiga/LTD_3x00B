  86          
  87          typedef enum { FALSE = 0, TRUE = !FALSE } bool, BOOL;
  88          typedef enum { LOW = 0, HIGH = !LOW } PortStatus;
  89          typedef enum { ERROR = 0, SUCCESS = !ERROR } ErrorStatus;
  90          typedef enum { RESET = 0, SET = !RESET } FlagStatus, ITStatus, BitStatus, BitAction;
  91          typedef enum { BIT0 = 0, BIT1, BIT2, BIT3, BIT4, BIT5, BIT6, BIT7 } BitPosition;
