  34          /* Data Type Definitions -----------------------------------------------------*/
  35          /**
  36           * IO definitions
  37           *
  38           * define access restrictions to peripheral registers
  39           */
  40          #define     __I     volatile const   /*!< defines 'read only' permissions     */
  41          #define     __O     volatile         /*!< defines 'write only' permissions    */
  42          #define     __IO    volatile         /*!< defines 'read / write' permissions  */
  43           
  44          /*!< Signed integer types  */
  45          typedef signed  char  s8;
  46          typedef signed  short   s16;
  47          typedef signed  long    s32;
  48          
  49          typedef signed  char    int8_t;
  50          typedef signed  short   int16_t;
  51          typedef signed  long    int32_t;
  52          
  53          typedef signed  char    INT8S;
  54          typedef signed  short   INT16S;
